{
  "name": "codewide",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build && pnpm build:companion",
    "typecheck": "pnpm typecheck:scripts && pnpm -r typecheck",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json",
    "test": "vitest run",
    "test:companion": "sh scripts/cargo-target-budget.sh && CODEWIDE_CARGO_TARGET_BUDGET_CHECKED=1 CARGO_TARGET_DIR=target CARGO_INCREMENTAL=0 cargo test --workspace",
    "test:cargo-target-budget": "sh scripts/cargo-target-budget.test.sh",
    "build:companion": "sh scripts/build-companion.sh",
    "test:e2e": "playwright test",
    "bench:fixtures": "tsx scripts/benchmark-deterministic-fixtures.ts",
    "bench:large-content": "sh scripts/cargo-target-budget.sh && CODEWIDE_CARGO_TARGET_BUDGET_CHECKED=1 CARGO_TARGET_DIR=target CARGO_INCREMENTAL=0 cargo test -p codewide-companion --test content_transport deterministic_large_content_projection_is_bounded -- --nocapture",
    "bench:markdown-parser": "tsx packages/rendering-core/scripts/benchmark-markdown-parser.mjs",
    "brand:generate": "node scripts/generate-codewide-assets.mjs",
    "soak:sync": "tsx scripts/soak-sync.ts",
    "test:android-device": "tsx scripts/android-device-gate.ts",
    "android:gradle": "sh scripts/android-gradle.sh",
    "dev:android": "sh scripts/android-fast-refresh.sh",
    "ota:publish": "tsx scripts/release-android.ts ota",
    "ota:publish:raw": "tsx scripts/publish-android-ota.ts",
    "release:ota": "tsx scripts/release-android.ts ota",
    "release:apk": "tsx scripts/release-android.ts apk",
    "release:plan": "node scripts/release-plan.ts",
    "release:set-plan": "node scripts/release-set-plan.ts",
    "release:compatibility": "node scripts/validate-release-compatibility.ts",
    "release:relay": "./scripts/release-relay-linux",
    "nx:graph": "nx graph",
    "nx:affected": "nx affected",
    "test:ota": "python3 scripts/test-ota-server.py",
    "security:scan-artifacts": "tsx scripts/scan-release-artifacts.ts",
    "security:scan-secrets": "tsx scripts/scan-secrets.ts",
    "release:gate": "sh scripts/cargo-target-budget.sh && export CODEWIDE_CARGO_TARGET_BUDGET_CHECKED=1 CARGO_TARGET_DIR=target CARGO_INCREMENTAL=0 && pnpm typecheck && pnpm test && pnpm test:companion && cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all -- --check && pnpm build:companion && pnpm bench:fixtures && pnpm bench:large-content && pnpm test:ota && pnpm security:scan-artifacts && pnpm security:scan-secrets",
    "test:watch": "vitest",
    "protocol:generate": "node scripts/generate-codex-protocol.ts",
    "validate:android:v1": "pnpm --filter @codewide/android validate:v1"
  },
  "devDependencies": {
    "@nx/expo": "23.2.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.1",
    "expo-pretext": "1.2.0",
    "nx": "23.2.1",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "ws": "8.21.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "packageExtensions": {
      "nx@23.2.1": {
        "dependencies": {
          "typescript": "6.0.3"
        }
      },
      "dependency-cruiser@18.2.0": {
        "dependencies": {
          "typescript": "6.0.3"
        }
      }
    },
    "overrides": {
      "uuid@<11.1.1": "11.1.1"
    },
    "patchedDependencies": {
      "expo-asset@57.0.9": "patches/expo-asset@57.0.9.patch",
      "expo-libghostty@0.8.1": "patches/expo-libghostty@0.8.1.patch",
      "expo-file-system@57.0.2": "patches/expo-file-system@57.0.2.patch",
      "@expo/ui@57.0.9": "patches/@expo__ui@57.0.9.patch",
      "@quickdrawjs/react-native@0.2.0": "patches/@quickdrawjs__react-native@0.2.0.patch",
      "react-native-enriched-markdown@1.0.2": "patches/react-native-enriched-markdown@1.0.2.patch",
      "expo-video@57.0.3": "patches/expo-video@57.0.3.patch",
      "expo-status-bar@57.0.1": "patches/expo-status-bar@57.0.1.patch",
      "react-native-webrtc@124.0.8": "patches/react-native-webrtc@124.0.8.patch",
      "react-native-keyboard-controller@1.21.9": "patches/react-native-keyboard-controller@1.21.9.patch"
    }
  }
}
