{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "relay",
  "projectType": "application",
  "sourceRoot": "apps/relay/src",
  "tags": ["language:rust", "type:application", "platform:linux"],
  "implicitDependencies": ["release-contracts"],
  "metadata": {
    "description": "Blind CodeWide Relay runtime",
    "codewideRelease": {
      "id": "relay",
      "runner": "linux",
      "tagPrefix": "relay-v",
      "baselineVersion": "0.1.0",
      "order": 10
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "rustWorkspace"]
  },
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p codewide-relay --all-targets --all-features -- -D warnings",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test -p codewide-relay --all-features",
        "cwd": "."
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/relay"],
      "options": {
        "command": "./scripts/build-relay-linux",
        "cwd": "."
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/release-relay-linux",
        "cwd": ".",
        "forwardAllArgs": true
      }
    }
  }
}
