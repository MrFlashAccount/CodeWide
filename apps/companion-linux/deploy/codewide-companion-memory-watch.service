[Unit]
Description=Check CodeWide Companion sustained RSS
After=codewide-companion.service

[Service]
Type=oneshot
ExecStart=%h/.local/lib/codewide/current/libexec/codewide-companion-memory-watch
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.local/state/codewide/companion
