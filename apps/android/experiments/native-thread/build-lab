#!/usr/bin/env python3
"""Build the lab-only x86_64 APK in a fresh directory outside the checkout."""
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

here = Path(__file__).resolve().parent
repo = here.parents[3]
android = repo / 'apps/android/android'
lab = Path(tempfile.mkdtemp(prefix='cw-native-thread-'))
java = lab / 'java'
shutil.copytree(android / 'app/src/main/java', java)
package = java / 'dev/codewide/app'

def insert(path, needle, addition):
    text = path.read_text()
    if text.count(needle) != 1:
        raise RuntimeError(f'Expected exactly one injection point in {path.name}')
    path.write_text(text.replace(needle, needle + addition))

insert(package/'remote/CodeWideModule.kt', 'override fun getConstants(): MutableMap<String, Any> = mutableMapOf(',
       '\n    "threadLabMode" to java.io.File(reactApplicationContext.cacheDir, "thread-lab-mode").let { if (it.isFile) it.readText().trim() else "stock" },')
insert(package/'remote/CodeWidePackage.kt', '      CodeWideModule(reactContext),',
       '\n      dev.codewide.app.rendering.LabProseModule(reactContext),\n      dev.codewide.app.LabOpeningWindowModule(reactContext),')
insert(package/'remote/CodeWidePackage.kt', '      MarkdownListManager(),',
       '\n      dev.codewide.app.rendering.LabTranscriptManager(),\n      dev.codewide.app.rendering.LabProseManager(),\n      dev.codewide.app.rendering.HostedTranscriptManager(),\n      dev.codewide.app.TranscriptProbeManager(),')
insert(package/'MainActivity.kt', 'class MainActivity : ReactActivity() {', '''
  private val perfettoBubble by lazy { BubbleProbe(this) }
  override fun dispatchTouchEvent(event: android.view.MotionEvent): Boolean {
    if (event.actionMasked == android.view.MotionEvent.ACTION_DOWN && android.os.Trace.isEnabled()) perfettoBubble.arm(event)
    return super.dispatchTouchEvent(event)
  }
''')
for name in ['HostedTranscriptManager.kt','LabTranscriptManager.kt','LabProse.kt']:
    shutil.copy(here/name, package/'rendering'/name)
shutil.copy(here/'BubbleProbe.kt',package)
shutil.copy(here/'LabOpeningWindowModule.kt',package)
env = dict(os.environ, CW_ROOT=str(repo), CW_LAB_OPENING_WINDOW='1', CW_NATIVE_LIST_DIR=str(lab), NODE_ENV='production')
env['NODE_OPTIONS'] = (env.get('NODE_OPTIONS', '') + ' --require=' + str(here/'preload.cjs')).strip()
if 'ANDROID_HOME' not in env:
    default = Path.home()/'.local/share/codewide-toolchains/android-sdk'
    if default.is_dir():
        env['ANDROID_HOME'] = str(default)
if 'JAVA_HOME' not in env:
    jdks = [jdk for jdk in (Path.home()/'.gradle/jdks').glob('*17*linux*') if (jdk/'bin/java').is_file()]
    if jdks:
        env['JAVA_HOME'] = str(sorted(jdks)[-1])
print(f'Lab build directory: {lab}', flush=True)
subprocess.run([android/'gradlew', '-p',android,'--max-workers=4','--console=plain','-I',here/'lab.gradle',
                '-PreactNativeArchitectures=x86_64', ':app:assemblePreview'],cwd=repo,env=env,check=True)
print(lab/'app-build/outputs/apk/preview/app-preview.apk')
