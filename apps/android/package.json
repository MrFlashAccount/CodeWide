{
  "name": "@codewide/android",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "sync:mermaid": "node scripts/sync-mermaid-asset.mjs",
    "sync:ascii-diagram": "node scripts/sync-ascii-diagram-asset.mjs",
    "sync:browser-devtools": "node scripts/sync-browser-devtools-asset.mjs",
    "sync:speedscope": "node scripts/sync-speedscope-asset.mjs",
    "sync:code-review": "node scripts/sync-code-review-editor-asset.mjs",
    "sync:file-registry": "node scripts/sync-code-file-registry.mjs",
    "sync:assets": "pnpm sync:file-registry && pnpm sync:mermaid && pnpm sync:ascii-diagram && pnpm sync:browser-devtools && pnpm sync:speedscope && pnpm sync:code-review",
    "preandroid": "pnpm sync:assets",
    "start": "expo start",
    "start:dev-client": "expo start --dev-client --localhost",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "pnpm lint:v1",
    "lint:v1": "pnpm lint:v1:source && pnpm lint:v1:dead-code && pnpm lint:v1:dependencies",
    "lint:v1:hygiene": "node scripts/validate-v1-hygiene.mjs",
    "lint:v1:hygiene:all": "oxlint --config oxlint.v1.config.mjs --tsconfig tsconfig.json --type-aware --type-check --deny-warnings --report-unused-disable-directives --no-error-on-unmatched-pattern app/legacy.tsx app/v1 src",
    "lint:v1:source": "pnpm lint:v1:hygiene",
    "lint:v1:dead-code": "knip --config knip.v1.config.mjs --workspace @codewide/android --include files,exports,nsExports,types,nsTypes,duplicates,unresolved,cycles,dependencies,devDependencies --treat-config-hints-as-errors",
    "format:v1": "oxfmt --config oxfmt.v1.json --write app/legacy.tsx app/v1 src",
    "format:v1:check": "oxfmt --config oxfmt.v1.json --check --no-error-on-unmatched-pattern app/legacy.tsx app/v1 src",
    "test:v1:render": "jest --config jest.v1.config.cjs --runInBand",
    "test:markup": "jest --config jest.markup.config.cjs --runInBand",
    "test:web-platform": "node --test test/web-platform.browser.test.mjs",
    "test:legend-list-unread-jump": "node --test test/legend-list-unread-jump.browser.test.mjs",
    "test:markdown-virtualization": "node --test test/markdown-virtualization.browser.test.mjs",
    "test:diagram-preview": "node --test test/diagram-preview.browser.test.mjs",
    "test:review-preview": "pnpm sync:code-review && node --test test/code-review-preview.browser.test.mjs test/footer-layout.browser.test.mjs",
    "typecheck:native": "tsc --noEmit",
    "typecheck:compatibility": "tsc --project tsconfig.compatibility.json --noEmit",
    "pretypecheck:web": "node scripts/sync-legend-list-native-types.mjs",
    "typecheck:web": "tsc --project tsconfig.web.json --noEmit",
    "typecheck": "pnpm typecheck:native && pnpm typecheck:web && pnpm typecheck:compatibility",
    "build": "expo export --platform web",
    "lint:v1:dependencies": "depcruise --config dependency-cruiser.v1.config.mjs --output-type err app src",
    "validate:v1": "pnpm format:v1:check && pnpm typecheck && pnpm test:v1:render && pnpm test:shared:render && pnpm lint:v1",
    "compile:android": "sh ../../scripts/validate-android-bundle.sh",
    "test:shared:render": "jest --config jest.shared.config.cjs --runInBand"
  },
  "dependencies": {
    "@codewide/codex-protocol": "workspace:*",
    "@codewide/domain": "workspace:*",
    "@codewide/file-types": "workspace:*",
    "@codewide/renderers": "workspace:*",
    "@codewide/rendering-core": "workspace:*",
    "@codewide/sync-client": "workspace:*",
    "@codewide/tanstack-db-sqlite": "workspace:*",
    "@expo/ui": "57.0.9",
    "@expo/vector-icons": "^15.1.1",
    "@legendapp/list": "3.3.11",
    "@legendapp/state": "2.1.15",
    "@native-html/render": "1.0.3",
    "@noble/hashes": "2.0.1",
    "@op-engineering/op-sqlite": "15.2.5",
    "@panzoom/panzoom": "4.6.2",
    "@pierre/diffs": "1.2.12",
    "@pierre/trees": "1.0.0-beta.6",
    "@quickdrawjs/react-native": "0.2.0",
    "@tanstack/db": "0.6.17",
    "@tanstack/react-db": "0.1.95",
    "base64-js": "1.5.1",
    "chii": "1.15.5",
    "expo": "57.0.11",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "57.0.1",
    "expo-libghostty": "0.8.1",
    "expo-linking": "57.0.5",
    "expo-local-authentication": "~57.0.2",
    "expo-router": "57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.13",
    "expo-video": "~57.0.3",
    "mermaid": "11.16.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-enriched-markdown": "1.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "124.0.8",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "svgbob-wasm": "1.0.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "7.27.1",
    "@react-native/jest-preset": "0.86.2",
    "@sergeigarin/hygene": "github:MrFlashAccount/hygiene#828e4a23b913b010ac314964b32aa903870fa621",
    "@testing-library/react-native": "13.3.3",
    "@types/mdast": "4.0.4",
    "@types/react": "^19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "babel-jest": "29.7.0",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-preset-expo": "57.0.6",
    "dependency-cruiser": "18.2.0",
    "esbuild": "0.28.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "29.7.0",
    "knip": "6.32.2",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-test-renderer": "19.2.3",
    "speedscope": "1.25.0",
    "tm-grammars": "1.32.5"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-ui"
        ]
      }
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
