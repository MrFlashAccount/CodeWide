{
  "expo": {
    "name": "CodeWide",
    "slug": "codewide",
    "version": "0.2.94",
    "runtimeVersion": "0.2.94-native-107",
    "updates": {
      "enabled": true,
      "url": "https://updates.example.invalid/api/updates",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 1200,
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "scheme": [
      "codewide",
      "codexremote"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CodeWide to use Face ID to unlock the app"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CodeWide to scan one-time host pairing QR codes",
          "recordAudioAndroid": false
        }
      ]
    ],
    "android": {
      "package": "dev.codexremote.app",
      "versionCode": 107,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#101011"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "syncV2Rollout": "canary"
    }
  }
}
