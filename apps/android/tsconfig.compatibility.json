// Retain the previous whole-project check, including web adapters, alongside
// the stricter Android runtime check. This does not model a web bundle graph.
{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "moduleSuffixes": [".native", ""],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "test/types/**/*.ts"]
}
