{
  "name": "@codewide/host-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "codewide-host": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/cli.ts serve",
    "smoke:live": "tsx src/live-smoke.ts",
    "smoke:external-device": "tsx src/external-device-smoke.ts",
    "smoke:live-mutations": "tsx src/live-mutation-smoke.ts",
    "smoke:live-dictation": "tsx src/live-dictation-smoke.ts",
    "smoke:compiled": "tsx src/compiled-binary-smoke.ts",
    "bench:rust-shadow": "tsx src/benchmark-rust-shadow.ts",
    "token:create": "tsx src/cli.ts create-token",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/cli.ts --target=node --outfile ./dist/codewide-host"
  },
  "dependencies": {
    "@codewide/codex-protocol": "workspace:*",
    "@codewide/file-types": "workspace:*",
    "mime-types": "3.0.2",
    "qrcode-terminal": "0.12.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/mime-types": "3.0.1",
    "@types/qrcode-terminal": "0.12.2",
    "@types/ws": "^8.18.1"
  }
}
