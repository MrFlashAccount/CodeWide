#!/bin/sh
set -eu

VERSION=${CODEWIDE_RELAY_VERSION:-}
INSTALL_DIR=${CODEWIDE_RELAY_INSTALL_DIR:-/usr/local/bin}
DOWNLOAD_BASE_URL=${CODEWIDE_RELAY_DOWNLOAD_BASE_URL:-}
ALLOW_INSECURE_DOWNLOAD=${CODEWIDE_RELAY_ALLOW_INSECURE_DOWNLOAD:-0}
TMP_ROOT=${TMPDIR:-/tmp}
activate=1
unit_root="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/codewide/relay"
unit_path="$unit_root/codewide-relay.service"
service_scope=user
service_existed=0
service_was_active=0
service_was_enabled=0
unit_created=0
activation_started=0
deployment_started=0
linger_changed=0
update_service=
update_path=
update_units_written=0
update_path_was_enabled=0

usage() {
  printf '%s\n' 'Usage: install-relay [--version VERSION] [--install-dir DIRECTORY] [--download-base-url URL] [--no-start]'
  printf '%s\n' 'Installs codewide-relay into /usr/local/bin, using sudo if needed.'
  printf '%s\n' 'Starts a persistent systemd service, ready for codewide-relay pair.'
  printf '%s\n' 'A custom installation directory must already be in PATH.'
  printf '%s\n' '--no-start installs only the executable (for manually managed deployments).'
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --version)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      VERSION=$2
      shift 2
      ;;
    --install-dir)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      INSTALL_DIR=$2
      shift 2
      ;;
    --download-base-url)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      DOWNLOAD_BASE_URL=$2
      shift 2
      ;;
    --no-start)
      activate=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

command -v curl >/dev/null 2>&1 || {
  printf '%s\n' 'curl is required to install CodeWide Relay.' >&2
  exit 2
}

privileged() {
  if [ "$(id -u)" = 0 ]; then
    "$@"
  else
    command -v sudo >/dev/null 2>&1 || {
      printf '%s\n' 'Administrator access is required to configure Relay autostart, but sudo is unavailable.' >&2
      return 2
    }
    sudo -- "$@"
  fi
}

user_systemctl() {
  relay_runtime_dir=${XDG_RUNTIME_DIR:-"/run/user/$(id -u)"}
  XDG_RUNTIME_DIR="$relay_runtime_dir" \
    DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$relay_runtime_dir/bus}" \
    systemctl --user "$@"
}

service_command() {
  if [ "$service_scope" = system ]; then
    privileged systemctl "$@" codewide-relay.service
  else
    user_systemctl "$@" codewide-relay.service
  fi
}

inspect_service() {
  [ "$activate" = 1 ] || return 0
  for dependency in systemctl loginctl timeout env; do
    command -v "$dependency" >/dev/null 2>&1 || {
      printf '%s is required for Relay autostart. Use --no-start for a binary-only installation.\n' "$dependency" >&2
      exit 2
    }
  done
  systemctl show --property=Version --value >/dev/null 2>&1 || {
    printf '%s\n' 'Relay autostart requires a running systemd manager. Nothing was installed. Use --no-start for a manually managed deployment.' >&2
    exit 2
  }
  system_fragment=$(systemctl show codewide-relay.service --property=FragmentPath --value 2>/dev/null || :)
  user_fragment=$(user_systemctl show codewide-relay.service --property=FragmentPath --value 2>/dev/null || :)
  if [ -n "$system_fragment" ] && { [ -n "$user_fragment" ] || [ -e "$unit_path" ]; }; then
    printf '%s\n' 'Both system and user Relay services exist. Refusing to choose a different Relay identity. Nothing was installed.' >&2
    exit 2
  fi
  if [ -n "$system_fragment" ]; then
    service_scope=system
    service_existed=1
  elif [ -n "$user_fragment" ] || [ -e "$unit_path" ]; then
    service_existed=1
  fi
  if service_command is-active --quiet; then service_was_active=1; fi
  if service_command is-enabled --quiet; then service_was_enabled=1; fi
  if [ "$service_scope" = user ]; then
    for path in "$unit_root" "$state_root" "$INSTALL_DIR"; do
      case "$path" in
        /*) ;;
        *) printf '%s\n' 'Relay service paths must be absolute. Nothing was installed.' >&2; exit 2 ;;
      esac
      if printf '%s' "$path" | LC_ALL=C grep -q '[[:cntrl:]]'; then
        printf '%s\n' 'Relay service paths cannot contain control characters. Nothing was installed.' >&2
        exit 2
      fi
    done
  fi
}

if [ -z "$VERSION" ]; then
  VERSION=$(curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
    https://raw.githubusercontent.com/MrFlashAccount/homebrew-codewide/main/versions/relay)
fi

case "$VERSION" in
  ''|*[!0-9A-Za-z._-]*)
    printf 'Invalid Relay version: %s\n' "$VERSION" >&2
    exit 2
    ;;
esac

case "$INSTALL_DIR" in
  /*) INSTALL_DIR=${INSTALL_DIR%/} ;;
  *) printf '%s\n' 'The installation directory must be an absolute path in PATH.' >&2; exit 2 ;;
esac
if [ -z "$INSTALL_DIR" ]; then
  printf '%s\n' 'Refusing to install into the filesystem root.' >&2
  exit 2
fi
case ":${PATH:-}:" in
  *":$INSTALL_DIR:"*) ;;
  *)
    printf 'Installation directory is not in PATH: %s\nChoose a directory already in PATH with --install-dir. Nothing was installed.\n' "$INSTALL_DIR" >&2
    exit 2
    ;;
esac
existing=$(command -v codewide-relay || :)
if [ -n "$existing" ] && [ "$existing" != "$INSTALL_DIR/codewide-relay" ]; then
  printf 'Another codewide-relay is already selected by PATH: %s\nUse --install-dir with its directory to update it. Nothing was installed.\n' "$existing" >&2
  exit 2
fi
if [ -d "$INSTALL_DIR/codewide-relay" ]; then
  printf 'Installation target is a directory: %s/codewide-relay\n' "$INSTALL_DIR" >&2
  exit 2
fi

if [ "$(uname -s)" != Linux ]; then
  printf '%s\n' 'CodeWide Relay currently supports Linux only.' >&2
  exit 2
fi
if [ "$(uname -m)" != x86_64 ]; then
  printf 'Unsupported Linux architecture: %s\n' "$(uname -m)" >&2
  exit 2
fi
inspect_service
runtime_binary="$INSTALL_DIR/codewide-relay"
updater_install_path="$INSTALL_DIR/codewide-relay-updater"
update_root="$state_root/update"
if [ "$activate" = 1 ] && [ "$service_scope" = user ]; then
  runtime_binary="$update_root/runtime/codewide-relay"
  updater_install_path="$update_root/bootstrap/codewide-relay-updater"
fi
target=x86_64-unknown-linux-musl
asset="codewide-relay-$target"
updater_asset="codewide-relay-updater-$target"
if [ -z "$DOWNLOAD_BASE_URL" ]; then
  # Versions through 0.4.0 used product tags; 0.4.1 starts the combined release.
  case "$VERSION" in
    0.0.*|0.1.*|0.2.*|0.3.*|0.4.0) release_tag="relay-v$VERSION" ;;
    0.4.*)
      # A patch bootstrap can also be dated; only legacy 0.4.x lacks an index.
      release_tag=$(curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
        "https://raw.githubusercontent.com/MrFlashAccount/homebrew-codewide/main/releases/relay/$VERSION" 2>/dev/null) \
        || release_tag="v$VERSION"
      ;;
    *)
      release_tag=$(curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
        "https://raw.githubusercontent.com/MrFlashAccount/homebrew-codewide/main/releases/relay/$VERSION")
      ;;
  esac
  printf '%s\n' "$release_tag" | grep -Eq '^(relay-v[0-9]+[.][0-9]+[.][0-9]+|v[0-9]+[.][0-9]+[.][0-9]+|release-[0-9]{4}-[0-9]{2}-[0-9]{2}[.][1-9][0-9]*)$' || {
    printf '%s\n' 'Invalid Relay release origin.' >&2; exit 2;
  }
  DOWNLOAD_BASE_URL="https://github.com/MrFlashAccount/CodeWide/releases/download/$release_tag"
fi
DOWNLOAD_BASE_URL=${DOWNLOAD_BASE_URL%/}

case "$DOWNLOAD_BASE_URL" in
  https://*) ;;
  http://*|file://*)
    if [ "$ALLOW_INSECURE_DOWNLOAD" != 1 ]; then
      printf '%s\n' 'Refusing a non-HTTPS download URL.' >&2
      exit 2
    fi
    ;;
  *)
    printf 'Unsupported download URL: %s\n' "$DOWNLOAD_BASE_URL" >&2
    exit 2
    ;;
esac

# Download and verify as the invoking user. Elevate only filesystem installation
# operations, so curl | sh works without running the downloaded script as root.
install_as_root=0
ancestor=$INSTALL_DIR
while [ ! -e "$ancestor" ]; do
  ancestor=$(dirname -- "$ancestor")
done
if [ ! -d "$ancestor" ] || [ ! -w "$ancestor" ] || [ ! -x "$ancestor" ]; then
  command -v sudo >/dev/null 2>&1 || {
    printf 'Installing to %s requires administrator access, but sudo is unavailable.\n' "$INSTALL_DIR" >&2
    exit 2
  }
  install_as_root=1
fi
install_command() {
  if [ "$install_as_root" = 1 ]; then
    sudo -- "$@"
  else
    "$@"
  fi
}

umask 077
temporary_root=$(mktemp -d "$TMP_ROOT/codewide-relay-install.XXXXXX")
staged=
unit_staged=
cleanup() {
  if [ -n "$staged" ]; then
    install_command rm -f -- "$staged"
  fi
  if [ -n "$unit_staged" ]; then rm -f -- "$unit_staged"; fi
  case "$temporary_root" in
    "$TMP_ROOT"/codewide-relay-install.*) rm -rf -- "$temporary_root" ;;
    *) printf 'Refusing to remove unexpected directory: %s\n' "$temporary_root" >&2 ;;
  esac
}

replace_binary() {
  target_path=$1
  source_path=$2
  target_dir=$(dirname -- "$target_path")
  direct_install=0
  if [ "$activate" = 1 ] && [ "$service_scope" = user ]; then
    case "$target_path" in "$update_root"/*) direct_install=1 ;; esac
  fi
  if [ "$direct_install" = 1 ]; then
    staged=$(mktemp "$target_dir/.codewide-relay.install.XXXXXX") || return 1
    cp "$source_path" "$staged" || return 1
    chmod 0755 "$staged" || return 1
    mv -f -- "$staged" "$target_path" || return 1
  else
    staged=$(install_command mktemp "$target_dir/.codewide-relay.install.XXXXXX") || return 1
    install_command cp "$source_path" "$staged" || return 1
    install_command chmod 0755 "$staged" || return 1
    install_command mv -f -- "$staged" "$target_path" || return 1
  fi
  staged=
}

finish() {
  status=$?
  trap - EXIT HUP INT TERM
  if [ "$status" -ne 0 ] && [ "$deployment_started" = 1 ]; then
    printf '%s\n' 'Relay installation failed; restoring the previous deployment without changing its state.' >&2
    if [ "$activation_started" = 1 ]; then service_command stop || :; fi
    if [ -f "$temporary_root/previous-binary" ]; then
      replace_binary "$runtime_binary" "$temporary_root/previous-binary" || printf '%s\n' 'Failed to restore the previous Relay executable.' >&2
    else
      if [ "$activate" = 1 ] && [ "$service_scope" = user ]; then rm -f -- "$runtime_binary" || :;
      else install_command rm -f -- "$runtime_binary" || :; fi
      if [ "$runtime_binary" != "$INSTALL_DIR/codewide-relay" ]; then install_command rm -f -- "$INSTALL_DIR/codewide-relay" || :; fi
    fi
    if [ -f "$temporary_root/previous-updater" ]; then
      replace_binary "$updater_install_path" "$temporary_root/previous-updater" || printf '%s\n' 'Failed to restore the previous Relay Updater executable.' >&2
    else
      install_command rm -f -- "$updater_install_path" || :
    fi
    if [ "$update_units_written" = 1 ]; then
      if [ "$service_scope" = system ]; then
        privileged systemctl disable --now codewide-relay-update.path || :
        if [ -f "$temporary_root/previous-update.service" ]; then privileged install -m 0644 "$temporary_root/previous-update.service" "$update_service"; else privileged rm -f -- "$update_service"; fi
        if [ -f "$temporary_root/previous-update.path" ]; then privileged install -m 0644 "$temporary_root/previous-update.path" "$update_path"; else privileged rm -f -- "$update_path"; fi
        privileged systemctl daemon-reload || :
        if [ "$update_path_was_enabled" = 1 ]; then privileged systemctl enable --now codewide-relay-update.path || :; fi
      else
        user_systemctl disable --now codewide-relay-update.path || :
        if [ -f "$temporary_root/previous-update.service" ]; then mv -f -- "$temporary_root/previous-update.service" "$update_service"; else rm -f -- "$update_service"; fi
        if [ -f "$temporary_root/previous-update.path" ]; then mv -f -- "$temporary_root/previous-update.path" "$update_path"; else rm -f -- "$update_path"; fi
        user_systemctl daemon-reload || :
        if [ "$update_path_was_enabled" = 1 ]; then user_systemctl enable --now codewide-relay-update.path || :; fi
      fi
    fi
    if [ "$activation_started" = 1 ] && [ "$service_was_enabled" = 0 ]; then
      service_command disable || :
    fi
    if [ "$unit_created" = 1 ]; then rm -f -- "$unit_path"; fi
    if [ "$activation_started" = 1 ]; then
      if [ "$service_scope" = system ]; then privileged systemctl daemon-reload || :;
      else user_systemctl daemon-reload || :; fi
      if [ "$service_was_active" = 1 ]; then
        if service_command restart; then
          wait_service_ready || printf '%s\n' 'The previous Relay could not become ready after rollback.' >&2
        else
          printf '%s\n' 'Failed to restart the previous Relay service.' >&2
        fi
      fi
    fi
    if [ "$linger_changed" = 1 ]; then privileged loginctl disable-linger "$(id -un)" || :; fi
  fi
  cleanup
  exit "$status"
}
trap finish EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# systemd expands percent specifiers and dollar variables even in quoted paths.
unit_argument() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/%/%%/g; s/\$/$$/g'
}

write_unit() {
  mkdir -p -- "$unit_root"
  unit_staged=$(mktemp "$unit_root/.codewide-relay.unit.XXXXXX")
  # systemd rejects a dollar sign in its executable token. env immediately
  # execs the Relay, preserving both literal installation paths and MainPID.
  printf '%s\n' '[Unit]' 'Description=CodeWide Relay' '' '[Service]' \
    "ExecStart=\"$(unit_argument "$(command -v env)")\" -- \"$(unit_argument "$INSTALL_DIR/codewide-relay")\" serve --state \"$(unit_argument "$state_root")\"" \
    'Restart=on-failure' 'RestartSec=2' 'TimeoutStopSec=20' 'UMask=0077' \
    'NoNewPrivileges=yes' '' '[Install]' 'WantedBy=default.target' >"$unit_staged"
  chmod 0644 "$unit_staged"
  unit_created=1
  mv -- "$unit_staged" "$unit_path"
  unit_staged=
}

write_update_units() {
  if [ "$service_scope" = system ]; then
    update_unit_root=${CODEWIDE_RELAY_SYSTEMD_UNIT_DIR:-/etc/systemd/system}
    case "$update_unit_root" in
      /*) ;;
      *) printf '%s\n' 'The systemd unit directory must be absolute.' >&2; return 1 ;;
    esac
    update_scope=system
  else
    update_unit_root=$unit_root
    update_scope=user
  fi
  if [ "$service_scope" = system ]; then privileged mkdir -p -- "$update_unit_root";
  else mkdir -p -- "$update_unit_root"; fi
  update_service="$update_unit_root/codewide-relay-update.service"
  update_path="$update_unit_root/codewide-relay-update.path"
  if [ "$service_scope" = system ]; then
    if privileged systemctl is-enabled codewide-relay-update.path >/dev/null 2>&1; then update_path_was_enabled=1; fi
  elif user_systemctl is-enabled codewide-relay-update.path >/dev/null 2>&1; then
    update_path_was_enabled=1
  fi
  if [ -f "$update_service" ]; then
    if [ "$service_scope" = system ]; then privileged cp -p "$update_service" "$temporary_root/previous-update.service";
    else cp -p "$update_service" "$temporary_root/previous-update.service"; fi
  fi
  if [ -f "$update_path" ]; then
    if [ "$service_scope" = system ]; then privileged cp -p "$update_path" "$temporary_root/previous-update.path";
    else cp -p "$update_path" "$temporary_root/previous-update.path"; fi
  fi
  service_staged=$(mktemp "$temporary_root/codewide-relay-update.service.XXXXXX")
  path_staged=$(mktemp "$temporary_root/codewide-relay-update.path.XXXXXX")
  printf '%s\n' '[Unit]' 'Description=CodeWide Relay Updater' 'After=network-online.target' 'Wants=network-online.target' '' '[Service]' 'Type=oneshot' 'UMask=0077' \
    "ExecStart=\"$(unit_argument "$updater_install_path")\" --state \"$(unit_argument "$state_root")\" --install-path \"$(unit_argument "$runtime_binary")\" --scope $update_scope --service codewide-relay.service" \
    'Restart=on-failure' 'RestartSec=2s' 'TimeoutStartSec=10min' 'NoNewPrivileges=true' 'PrivateTmp=false' \
    "ReadWritePaths=\"$(unit_argument "$update_root")\" \"$(unit_argument "$(dirname -- "$runtime_binary")")\"" \
    'ProtectSystem=full' 'ProtectHome=read-only' '' >"$service_staged"
  if [ "$service_scope" = user ]; then
    printf '%s\n' 'CapabilityBoundingSet=' 'AmbientCapabilities=' >>"$service_staged"
  fi
  printf '%s\n' '[Unit]' 'Description=Start CodeWide Relay Updater for a durable pending operation' '' '[Path]' \
    "PathExists=$(unit_argument "$update_root/pending")" 'Unit=codewide-relay-update.service' '' '[Install]' 'WantedBy=default.target' >"$path_staged"
  chmod 0644 "$service_staged" "$path_staged"
  if [ "$service_scope" = system ]; then
    privileged install -m 0644 "$service_staged" "$update_service"
    privileged install -m 0644 "$path_staged" "$update_path"
  else
    mv -f -- "$service_staged" "$update_service"
    mv -f -- "$path_staged" "$update_path"
  fi
  update_units_written=1
}

start_service() {
  if [ "$service_scope" = user ]; then
    if [ "$(loginctl show-user "$(id -un)" --property=Linger --value 2>/dev/null || :)" != yes ]; then
      linger_changed=1
      privileged loginctl enable-linger "$(id -un)"
    fi
    # Enabling lingering can start a previously absent user manager. Wait for
    # its bus rather than racing systemctl against that asynchronous startup.
    attempt=0
    until user_systemctl show-environment >/dev/null 2>"$temporary_root/manager-error"; do
      attempt=$((attempt + 1))
      if [ "$attempt" -ge 10 ]; then
        printf '%s\n' 'The systemd user manager did not become available.' >&2
        sed -n '1,8p' "$temporary_root/manager-error" >&2
        return 1
      fi
      sleep 1
    done
    if [ "$service_existed" = 0 ] && \
      [ -n "$(user_systemctl show codewide-relay.service --property=FragmentPath --value)" ]; then
      # A pre-existing global user unit can become visible after the bus starts.
      service_existed=1
      if service_command is-active --quiet; then service_was_active=1; fi
      if service_command is-enabled --quiet; then service_was_enabled=1; fi
    fi
    if [ "$service_existed" = 0 ]; then write_unit; fi
    user_systemctl daemon-reload
  else
    privileged systemctl daemon-reload
  fi
  write_update_units
  if [ "$service_scope" = system ]; then privileged systemctl daemon-reload;
  else user_systemctl daemon-reload; fi
  activation_started=1
  service_command enable
  if [ "$service_scope" = system ]; then privileged systemctl enable --now codewide-relay-update.path;
  else user_systemctl enable --now codewide-relay-update.path; fi
  service_command restart
  wait_service_ready
}

wait_service_ready() {
  attempt=0
  while [ "$attempt" -lt 10 ]; do
    if service_command is-active --quiet && \
      timeout 2 "$INSTALL_DIR/codewide-relay" status --json >"$temporary_root/status" 2>"$temporary_root/status-error"; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
  printf '%s\n' 'Relay did not become ready through its administration socket.' >&2
  if [ -f "$temporary_root/status-error" ]; then sed -n '1,8p' "$temporary_root/status-error" >&2; fi
  return 1
}

download() {
  source_url=$1
  destination=$2
  if [ "$ALLOW_INSECURE_DOWNLOAD" = 1 ]; then
    curl --fail --silent --show-error --location --retry 3 \
      --output "$destination" "$source_url"
  else
    curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
      --location --retry 3 --output "$destination" "$source_url"
  fi
}

payload="$temporary_root/$asset"
checksum="$temporary_root/$asset.sha256"
updater_payload="$temporary_root/$updater_asset"
updater_checksum="$temporary_root/$updater_asset.sha256"
download "$DOWNLOAD_BASE_URL/$asset" "$payload"
download "$DOWNLOAD_BASE_URL/$asset.sha256" "$checksum"
download "$DOWNLOAD_BASE_URL/$updater_asset" "$updater_payload"
download "$DOWNLOAD_BASE_URL/$updater_asset.sha256" "$updater_checksum"

line_count=$(wc -l <"$checksum" | tr -d ' ')
expected=$(awk 'NR == 1 { print $1 }' "$checksum")
recorded_name=$(awk 'NR == 1 { print $2 }' "$checksum")
recorded_name=${recorded_name#\*}
case "$expected" in
  ????????????????????????????????????????????????????????????????) ;;
  *) printf '%s\n' 'Relay checksum has an invalid length.' >&2; exit 1 ;;
esac
case "$expected" in
  *[!0-9a-f]*) printf '%s\n' 'Relay checksum is malformed.' >&2; exit 1 ;;
esac
if [ "$line_count" != 1 ] || [ "$recorded_name" != "$asset" ]; then
  printf '%s\n' 'Relay checksum manifest is malformed.' >&2
  exit 1
fi

if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$payload" | awk '{ print $1 }')
elif command -v shasum >/dev/null 2>&1; then
  actual=$(shasum -a 256 "$payload" | awk '{ print $1 }')
else
  printf '%s\n' 'sha256sum or shasum is required to verify CodeWide Relay.' >&2
  exit 2
fi
if [ "$actual" != "$expected" ]; then
  printf '%s\n' 'CodeWide Relay checksum verification failed.' >&2
  exit 1
fi

updater_line_count=$(wc -l <"$updater_checksum" | tr -d ' ')
updater_expected=$(awk 'NR == 1 { print $1 }' "$updater_checksum")
updater_recorded_name=$(awk 'NR == 1 { print $2 }' "$updater_checksum")
updater_recorded_name=${updater_recorded_name#\*}
case "$updater_expected" in
  ????????????????????????????????????????????????????????????????) ;;
  *) printf '%s\n' 'Relay Updater checksum has an invalid length.' >&2; exit 1 ;;
esac
case "$updater_expected" in
  *[!0-9a-f]*) printf '%s\n' 'Relay Updater checksum is malformed.' >&2; exit 1 ;;
esac
if [ "$updater_line_count" != 1 ] || [ "$updater_recorded_name" != "$updater_asset" ]; then
  printf '%s\n' 'Relay Updater checksum manifest is malformed.' >&2
  exit 1
fi
if command -v sha256sum >/dev/null 2>&1; then
  updater_actual=$(sha256sum "$updater_payload" | awk '{ print $1 }')
else
  updater_actual=$(shasum -a 256 "$updater_payload" | awk '{ print $1 }')
fi
if [ "$updater_actual" != "$updater_expected" ]; then
  printf '%s\n' 'CodeWide Relay Updater checksum verification failed.' >&2
  exit 1
fi

chmod 0755 "$payload"
chmod 0755 "$updater_payload"
reported_version=$("$payload" --version)
if [ "$reported_version" != "codewide-relay $VERSION" ]; then
  printf 'Downloaded Relay version mismatch: %s\n' "$reported_version" >&2
  exit 1
fi
if [ "$activate" = 1 ] && [ "$service_existed" = 1 ]; then
  if [ "$service_was_active" != 1 ]; then
    printf '%s\n' 'The existing Relay service must be running so its state directory can be verified safely.' >&2
    exit 1
  fi
  if [ "$service_scope" = system ]; then state_root=$(privileged "$payload" bootstrap-info);
  else state_root=$("$payload" bootstrap-info); fi
  case "$state_root" in
    /*) ;;
    *) printf '%s\n' 'The active Relay reported an invalid state directory.' >&2; exit 1 ;;
  esac
  if printf '%s' "$state_root" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    printf '%s\n' 'The active Relay reported an unsafe state directory.' >&2
    exit 1
  fi
  [ -d "$state_root" ] || {
    printf '%s\n' 'The active Relay state directory does not exist.' >&2
    exit 1
  }
  update_root="$state_root/update"
  if [ "$service_scope" = user ]; then
    runtime_binary="$update_root/runtime/codewide-relay"
    updater_install_path="$update_root/bootstrap/codewide-relay-updater"
  fi
fi
if [ "$activate" = 1 ] && [ "$service_existed" = 0 ] && \
  [ -S "$state_root/control.sock" ] && \
  timeout 5 "$payload" --state "$state_root" status --json >/dev/null 2>&1; then
  printf '%s\n' 'A manually managed Relay is already running. Refusing to start a second server. Nothing was installed. Use --no-start to update only its executable.' >&2
  exit 2
fi

if [ "$install_as_root" = 1 ]; then
  printf 'Installing to %s (administrator access required).\n' "$INSTALL_DIR"
  sudo -v
fi
# Public executable directories must be traversable by the service owner too.
# Leave permissions of existing directories alone.
(umask 022; install_command mkdir -p -m 0755 "$INSTALL_DIR")
if [ -f "$INSTALL_DIR/codewide-relay" ]; then
  install_command cp -p "$INSTALL_DIR/codewide-relay" "$temporary_root/previous-binary"
fi
if [ -f "$updater_install_path" ]; then
  install_command cp -p "$updater_install_path" "$temporary_root/previous-updater"
fi
deployment_started=1
if [ "$activate" = 1 ]; then
  if [ "$service_scope" = user ]; then
    mkdir -p -- "$(dirname -- "$runtime_binary")" "$(dirname -- "$updater_install_path")" "$update_root/operations" "$update_root/receipts"
    chmod 0700 "$update_root" "$(dirname -- "$runtime_binary")" "$(dirname -- "$updater_install_path")" "$update_root/operations" "$update_root/receipts"
  else
    state_owner=$(privileged stat -c '%u:%g' "$state_root")
    privileged mkdir -p -- "$update_root/operations" "$update_root/receipts"
    privileged chmod 0700 "$update_root" "$update_root/operations" "$update_root/receipts"
    privileged chown -R "$state_owner" "$update_root"
    install_command mkdir -p -m 0755 "$(dirname -- "$updater_install_path")"
  fi
else
  install_command mkdir -p -m 0755 "$(dirname -- "$updater_install_path")"
fi
replace_binary "$runtime_binary" "$payload"
replace_binary "$updater_install_path" "$updater_payload"
if [ "$activate" = 1 ] && [ "$service_scope" = user ]; then
  link_staged="$INSTALL_DIR/.codewide-relay.link.$$"
  install_command ln -s "$runtime_binary" "$link_staged"
  install_command mv -f -- "$link_staged" "$INSTALL_DIR/codewide-relay"
fi
if [ "$activate" = 1 ]; then
  trust=$("$updater_install_path" --print-trust)
  key_id=$(printf '%s\n' "$trust" | awk -F '\t' '{print $1}')
  public_key=$(printf '%s\n' "$trust" | awk -F '\t' '{print $2}')
  updater_version=$(printf '%s\n' "$trust" | awk -F '\t' '{print $3}')
  source_revision=$(printf '%s\n' "$trust" | awk -F '\t' '{print $4}')
  if [ "$updater_version" != "$VERSION" ]; then
    printf '%s\n' 'Relay and Relay Updater versions do not match.' >&2
    exit 1
  fi
  build=$(printf '%.12s' "$source_revision")
  json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
  config_tmp="$temporary_root/config.json"
  printf '{"schemaVersion":1,"keyId":"%s","publicKeySpki":"%s","manifestUrl":"%s","installPath":"%s","updaterPath":"%s","serviceScope":"%s","serviceName":"codewide-relay.service"}\n' \
    "$(json_escape "$key_id")" "$(json_escape "$public_key")" \
    'https://github.com/MrFlashAccount/CodeWide/releases/latest/download/release-manifest.json' \
    "$(json_escape "$runtime_binary")" "$(json_escape "$updater_install_path")" "$service_scope" >"$config_tmp"
  chmod 0600 "$config_tmp"
  installed_tmp="$temporary_root/installed.json"
  printf '{"schemaVersion":1,"version":"%s","build":"%s","sourceRevision":"%s","artifactDigest":"%s","highestSequence":0}\n' \
    "$VERSION" "$build" "$source_revision" "$expected" >"$installed_tmp"
  chmod 0600 "$installed_tmp"
  if [ "$service_scope" = system ]; then
    privileged install -m 0600 -o "${state_owner%:*}" -g "${state_owner#*:}" "$config_tmp" "$update_root/config.json"
    privileged install -m 0600 -o "${state_owner%:*}" -g "${state_owner#*:}" "$installed_tmp" "$update_root/installed.json"
  else
    mv -f -- "$config_tmp" "$update_root/config.json"
    mv -f -- "$installed_tmp" "$update_root/installed.json"
  fi
fi

hash -r 2>/dev/null || :
resolved=$(command -v codewide-relay || :)
if [ "$resolved" != "$INSTALL_DIR/codewide-relay" ] ||
  [ "$(codewide-relay --version)" != "codewide-relay $VERSION" ]; then
  printf 'Relay was copied, but command lookup verification failed: %s\n' "$resolved" >&2
  exit 1
fi
printf 'Installed codewide-relay %s to %s\n' "$VERSION" "$resolved"
if [ "$activate" = 1 ]; then
  start_service
  printf '%s\n' 'Relay is running and will start automatically after logout and reboot.'
  printf '%s\n' 'Ready: codewide-relay pair' 'Allow inbound TCP 8780 in your VPS firewall (or the existing service port if customized).'
else
  printf '%s\n' 'Service activation skipped. Executable ready: codewide-relay'
fi
deployment_started=0
