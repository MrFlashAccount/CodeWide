#!/bin/sh
set -eu

VERSION=${CODEWIDE_RELAY_VERSION:-}
INSTALL_DIR=${CODEWIDE_RELAY_INSTALL_DIR:-/usr/local/bin}
DOWNLOAD_BASE_URL=${CODEWIDE_RELAY_DOWNLOAD_BASE_URL:-}
ALLOW_INSECURE_DOWNLOAD=${CODEWIDE_RELAY_ALLOW_INSECURE_DOWNLOAD:-0}
TMP_ROOT=${TMPDIR:-/tmp}

usage() {
  printf '%s\n' 'Usage: install-relay [--version VERSION] [--install-dir DIRECTORY] [--download-base-url URL]'
  printf '%s\n' 'Installs codewide-relay into /usr/local/bin, using sudo if needed.'
  printf '%s\n' 'A custom installation directory must already be in PATH.'
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --version)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      VERSION=$2
      shift 2
      ;;
    --install-dir)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      INSTALL_DIR=$2
      shift 2
      ;;
    --download-base-url)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      DOWNLOAD_BASE_URL=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

command -v curl >/dev/null 2>&1 || {
  printf '%s\n' 'curl is required to install CodeWide Relay.' >&2
  exit 2
}

if [ -z "$VERSION" ]; then
  VERSION=$(curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
    https://raw.githubusercontent.com/MrFlashAccount/homebrew-codewide/main/versions/relay)
fi

case "$VERSION" in
  ''|*[!0-9A-Za-z._-]*)
    printf 'Invalid Relay version: %s\n' "$VERSION" >&2
    exit 2
    ;;
esac

case "$INSTALL_DIR" in
  /*) INSTALL_DIR=${INSTALL_DIR%/} ;;
  *) printf '%s\n' 'The installation directory must be an absolute path in PATH.' >&2; exit 2 ;;
esac
if [ -z "$INSTALL_DIR" ]; then
  printf '%s\n' 'Refusing to install into the filesystem root.' >&2
  exit 2
fi
case ":${PATH:-}:" in
  *":$INSTALL_DIR:"*) ;;
  *)
    printf 'Installation directory is not in PATH: %s\nChoose a directory already in PATH with --install-dir. Nothing was installed.\n' "$INSTALL_DIR" >&2
    exit 2
    ;;
esac
existing=$(command -v codewide-relay || :)
if [ -n "$existing" ] && [ "$existing" != "$INSTALL_DIR/codewide-relay" ]; then
  printf 'Another codewide-relay is already selected by PATH: %s\nUse --install-dir with its directory to update it. Nothing was installed.\n' "$existing" >&2
  exit 2
fi
if [ -d "$INSTALL_DIR/codewide-relay" ]; then
  printf 'Installation target is a directory: %s/codewide-relay\n' "$INSTALL_DIR" >&2
  exit 2
fi

if [ "$(uname -s)" != Linux ]; then
  printf '%s\n' 'CodeWide Relay currently supports Linux only.' >&2
  exit 2
fi
if [ "$(uname -m)" != x86_64 ]; then
  printf 'Unsupported Linux architecture: %s\n' "$(uname -m)" >&2
  exit 2
fi
target=x86_64-unknown-linux-musl
asset="codewide-relay-$target"
if [ -z "$DOWNLOAD_BASE_URL" ]; then
  # Versions through 0.4.0 used product tags; 0.4.1 starts the combined release.
  case "$VERSION" in
    0.0.*|0.1.*|0.2.*|0.3.*|0.4.0) release_tag="relay-v$VERSION" ;;
    0.4.*)
      # A patch bootstrap can also be dated; only legacy 0.4.x lacks an index.
      release_tag=$(curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
        "https://raw.githubusercontent.com/MrFlashAccount/homebrew-codewide/main/releases/relay/$VERSION" 2>/dev/null) \
        || release_tag="v$VERSION"
      ;;
    *)
      release_tag=$(curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
        "https://raw.githubusercontent.com/MrFlashAccount/homebrew-codewide/main/releases/relay/$VERSION")
      ;;
  esac
  printf '%s\n' "$release_tag" | grep -Eq '^(relay-v[0-9]+[.][0-9]+[.][0-9]+|v[0-9]+[.][0-9]+[.][0-9]+|release-[0-9]{4}-[0-9]{2}-[0-9]{2}[.][1-9][0-9]*)$' || {
    printf '%s\n' 'Invalid Relay release origin.' >&2; exit 2;
  }
  DOWNLOAD_BASE_URL="https://github.com/MrFlashAccount/CodeWide/releases/download/$release_tag"
fi
DOWNLOAD_BASE_URL=${DOWNLOAD_BASE_URL%/}

case "$DOWNLOAD_BASE_URL" in
  https://*) ;;
  http://*|file://*)
    if [ "$ALLOW_INSECURE_DOWNLOAD" != 1 ]; then
      printf '%s\n' 'Refusing a non-HTTPS download URL.' >&2
      exit 2
    fi
    ;;
  *)
    printf 'Unsupported download URL: %s\n' "$DOWNLOAD_BASE_URL" >&2
    exit 2
    ;;
esac

command -v curl >/dev/null 2>&1 || {
  printf '%s\n' 'curl is required to install CodeWide Relay.' >&2
  exit 2
}

# Download and verify as the invoking user. Elevate only filesystem installation
# operations, so curl | sh works without running the downloaded script as root.
install_as_root=0
ancestor=$INSTALL_DIR
while [ ! -e "$ancestor" ]; do
  ancestor=$(dirname -- "$ancestor")
done
if [ ! -d "$ancestor" ] || [ ! -w "$ancestor" ] || [ ! -x "$ancestor" ]; then
  command -v sudo >/dev/null 2>&1 || {
    printf 'Installing to %s requires administrator access, but sudo is unavailable.\n' "$INSTALL_DIR" >&2
    exit 2
  }
  install_as_root=1
fi
install_command() {
  if [ "$install_as_root" = 1 ]; then
    sudo -- "$@"
  else
    "$@"
  fi
}

umask 077
temporary_root=$(mktemp -d "$TMP_ROOT/codewide-relay-install.XXXXXX")
staged=
cleanup() {
  if [ -n "$staged" ]; then
    install_command rm -f -- "$staged"
  fi
  case "$temporary_root" in
    "$TMP_ROOT"/codewide-relay-install.*) rm -rf -- "$temporary_root" ;;
    *) printf 'Refusing to remove unexpected directory: %s\n' "$temporary_root" >&2 ;;
  esac
}
trap cleanup EXIT HUP INT TERM

download() {
  source_url=$1
  destination=$2
  if [ "$ALLOW_INSECURE_DOWNLOAD" = 1 ]; then
    curl --fail --silent --show-error --location --retry 3 \
      --output "$destination" "$source_url"
  else
    curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
      --location --retry 3 --output "$destination" "$source_url"
  fi
}

payload="$temporary_root/$asset"
checksum="$temporary_root/$asset.sha256"
download "$DOWNLOAD_BASE_URL/$asset" "$payload"
download "$DOWNLOAD_BASE_URL/$asset.sha256" "$checksum"

line_count=$(wc -l <"$checksum" | tr -d ' ')
expected=$(awk 'NR == 1 { print $1 }' "$checksum")
recorded_name=$(awk 'NR == 1 { print $2 }' "$checksum")
recorded_name=${recorded_name#\*}
case "$expected" in
  ????????????????????????????????????????????????????????????????) ;;
  *) printf '%s\n' 'Relay checksum has an invalid length.' >&2; exit 1 ;;
esac
case "$expected" in
  *[!0-9a-f]*) printf '%s\n' 'Relay checksum is malformed.' >&2; exit 1 ;;
esac
if [ "$line_count" != 1 ] || [ "$recorded_name" != "$asset" ]; then
  printf '%s\n' 'Relay checksum manifest is malformed.' >&2
  exit 1
fi

if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$payload" | awk '{ print $1 }')
elif command -v shasum >/dev/null 2>&1; then
  actual=$(shasum -a 256 "$payload" | awk '{ print $1 }')
else
  printf '%s\n' 'sha256sum or shasum is required to verify CodeWide Relay.' >&2
  exit 2
fi
if [ "$actual" != "$expected" ]; then
  printf '%s\n' 'CodeWide Relay checksum verification failed.' >&2
  exit 1
fi

chmod 0755 "$payload"
reported_version=$("$payload" --version)
if [ "$reported_version" != "codewide-relay $VERSION" ]; then
  printf 'Downloaded Relay version mismatch: %s\n' "$reported_version" >&2
  exit 1
fi

if [ "$install_as_root" = 1 ]; then
  printf 'Installing to %s (administrator access required).\n' "$INSTALL_DIR"
  sudo -v
fi
# Public executable directories must be traversable by the service owner too.
# Leave permissions of existing directories alone.
(umask 022; install_command mkdir -p -m 0755 "$INSTALL_DIR")
staged=$(install_command mktemp "$INSTALL_DIR/.codewide-relay.install.XXXXXX")
install_command cp "$payload" "$staged"
install_command chmod 0755 "$staged"
install_command mv -f -- "$staged" "$INSTALL_DIR/codewide-relay"
staged=

hash -r 2>/dev/null || :
resolved=$(command -v codewide-relay || :)
if [ "$resolved" != "$INSTALL_DIR/codewide-relay" ] ||
  [ "$(codewide-relay --version)" != "codewide-relay $VERSION" ]; then
  printf 'Relay was copied, but command lookup verification failed: %s\n' "$resolved" >&2
  exit 1
fi
printf 'Installed codewide-relay %s to %s\n' "$VERSION" "$resolved"
printf '%s\n' 'Ready: codewide-relay'
