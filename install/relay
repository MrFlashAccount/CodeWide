#!/bin/sh
set -eu

VERSION=${CODEWIDE_RELAY_VERSION:-}
INSTALL_DIR=${CODEWIDE_RELAY_INSTALL_DIR:-}
DOWNLOAD_BASE_URL=${CODEWIDE_RELAY_DOWNLOAD_BASE_URL:-}
ALLOW_INSECURE_DOWNLOAD=${CODEWIDE_RELAY_ALLOW_INSECURE_DOWNLOAD:-0}
TMP_ROOT=${TMPDIR:-/tmp}
activate=1
unit_root="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/codewide/relay"
unit_path="$unit_root/codewide-relay.service"
service_scope=user
service_existed=0
service_was_active=0
service_was_enabled=0
unit_created=0
activation_started=0
deployment_started=0
install_root=${CODEWIDE_RELAY_INSTALL_ROOT:-"$HOME/.local/lib/codewide-relay"}
update_service=
update_unit_written=0

usage() {
  printf '%s\n' 'Usage: install-relay [--version VERSION] [--install-dir DIRECTORY] [--download-base-url URL] [--no-start]'
  printf '%s\n' 'Installs codewide-relay into a standard user directory already in PATH, without sudo.'
  printf '%s\n' 'Starts a systemd user service, ready for codewide-relay pair.'
  printf '%s\n' 'An existing system service keeps its machine-wide installation and requires administrator access.'
  printf '%s\n' 'A custom installation directory must already be in PATH.'
  printf '%s\n' '--no-start installs only the executable (for manually managed deployments).'
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --version)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      VERSION=$2
      shift 2
      ;;
    --install-dir)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      INSTALL_DIR=$2
      shift 2
      ;;
    --download-base-url)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      DOWNLOAD_BASE_URL=$2
      shift 2
      ;;
    --no-start)
      activate=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

command -v curl >/dev/null 2>&1 || {
  printf '%s\n' 'curl is required to install CodeWide Relay.' >&2
  exit 2
}

privileged() {
  if [ "$(id -u)" = 0 ]; then
    "$@"
  else
    command -v sudo >/dev/null 2>&1 || {
      printf '%s\n' 'Administrator access is required to update the existing system Relay service, but sudo is unavailable.' >&2
      return 2
    }
    sudo -- "$@"
  fi
}

user_systemctl() {
  relay_runtime_dir=${XDG_RUNTIME_DIR:-"/run/user/$(id -u)"}
  XDG_RUNTIME_DIR="$relay_runtime_dir" \
    DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$relay_runtime_dir/bus}" \
    systemctl --user "$@"
}

service_command() {
  if [ "$service_scope" = system ]; then
    privileged systemctl "$@" codewide-relay.service
  else
    user_systemctl "$@" codewide-relay.service
  fi
}

inspect_service() {
  [ "$activate" = 1 ] || return 0
  for dependency in systemctl loginctl timeout env; do
    command -v "$dependency" >/dev/null 2>&1 || {
      printf '%s is required for Relay autostart. Use --no-start for a binary-only installation.\n' "$dependency" >&2
      exit 2
    }
  done
  systemctl show --property=Version --value >/dev/null 2>&1 || {
    printf '%s\n' 'Relay autostart requires a running systemd manager. Nothing was installed. Use --no-start for a manually managed deployment.' >&2
    exit 2
  }
  system_fragment=$(systemctl show codewide-relay.service --property=FragmentPath --value 2>/dev/null || :)
  user_fragment=$(user_systemctl show codewide-relay.service --property=FragmentPath --value 2>/dev/null || :)
  if [ -n "$system_fragment" ] && { [ -n "$user_fragment" ] || [ -e "$unit_path" ]; }; then
    printf '%s\n' 'Both system and user Relay services exist. Refusing to choose a different Relay identity. Nothing was installed.' >&2
    exit 2
  fi
  if [ -n "$system_fragment" ]; then
    service_scope=system
    service_existed=1
  elif [ -n "$user_fragment" ] || [ -e "$unit_path" ]; then
    service_existed=1
  fi
  if service_command is-active --quiet; then service_was_active=1; fi
  if service_command is-enabled --quiet; then service_was_enabled=1; fi
}

if [ -z "$VERSION" ]; then
  VERSION=$(curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
    https://raw.githubusercontent.com/MrFlashAccount/homebrew-codewide/main/versions/relay)
fi

case "$VERSION" in
  ''|*[!0-9A-Za-z._-]*)
    printf 'Invalid Relay version: %s\n' "$VERSION" >&2
    exit 2
    ;;
esac

if [ "$(uname -s)" != Linux ]; then
  printf '%s\n' 'CodeWide Relay currently supports Linux only.' >&2
  exit 2
fi
if [ "$(uname -m)" != x86_64 ]; then
  printf 'Unsupported Linux architecture: %s\n' "$(uname -m)" >&2
  exit 2
fi
inspect_service
existing=$(command -v codewide-relay || :)
if [ -z "$INSTALL_DIR" ]; then
  if [ "$service_scope" = system ]; then
    INSTALL_DIR=/usr/local/bin
  elif [ "$service_existed" = 1 ] && [ -n "$existing" ]; then
    INSTALL_DIR=$(dirname -- "$existing")
  elif case ":${PATH:-}:" in *":$HOME/.local/bin:"*) true ;; *) false ;; esac; then
    INSTALL_DIR=$HOME/.local/bin
  elif case ":${PATH:-}:" in *":$HOME/bin:"*) true ;; *) false ;; esac; then
    INSTALL_DIR=$HOME/bin
  else
    printf '%s\n' 'No standard user executable directory is present in PATH.' >&2
    printf '%s\n' 'Add ~/.local/bin or ~/bin to PATH, then run the installer again. Nothing was installed.' >&2
    exit 2
  fi
fi

case "$INSTALL_DIR" in
  /*) INSTALL_DIR=${INSTALL_DIR%/} ;;
  *) printf '%s\n' 'The installation directory must be an absolute path in PATH.' >&2; exit 2 ;;
esac
if [ -z "$INSTALL_DIR" ]; then
  printf '%s\n' 'Refusing to install into the filesystem root.' >&2
  exit 2
fi
if [ "$service_scope" = user ]; then
  for path in "$unit_root" "$state_root" "$INSTALL_DIR"; do
    case "$path" in
      /*) ;;
      *) printf '%s\n' 'Relay service paths must be absolute. Nothing was installed.' >&2; exit 2 ;;
    esac
    if printf '%s' "$path" | LC_ALL=C grep -q '[[:cntrl:]]'; then
      printf '%s\n' 'Relay service paths cannot contain control characters. Nothing was installed.' >&2
      exit 2
    fi
  done
fi
case ":${PATH:-}:" in
  *":$INSTALL_DIR:"*) ;;
  *)
    printf 'Installation directory is not in PATH: %s\nChoose a directory already in PATH with --install-dir. Nothing was installed.\n' "$INSTALL_DIR" >&2
    exit 2
    ;;
esac
if [ -n "$existing" ] && [ "$existing" != "$INSTALL_DIR/codewide-relay" ]; then
  printf 'Another codewide-relay is already selected by PATH: %s\nUse --install-dir with its directory to update it. Nothing was installed.\n' "$existing" >&2
  exit 2
fi
if [ -d "$INSTALL_DIR/codewide-relay" ]; then
  printf 'Installation target is a directory: %s/codewide-relay\n' "$INSTALL_DIR" >&2
  exit 2
fi

target=x86_64-unknown-linux-musl
asset="codewide-relay-$target"
bundle_directory="codewide-relay-$target"
# A managed user service installs the signed generation bundle that remote
# updates replace; --no-start and a legacy system service install the binary.
managed=0
if [ "$activate" = 1 ] && [ "$service_scope" = user ]; then
  managed=1
  case "$install_root" in
    /*) ;;
    *) printf '%s\n' 'The Relay install root must be an absolute path. Nothing was installed.' >&2; exit 2 ;;
  esac
  if printf '%s' "$install_root" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    printf '%s\n' 'The Relay install root cannot contain control characters. Nothing was installed.' >&2
    exit 2
  fi
  asset="$bundle_directory.tar.gz"
fi
if [ -z "$DOWNLOAD_BASE_URL" ]; then
  # Versions through 0.4.0 used product tags; 0.4.1 starts the combined release.
  case "$VERSION" in
    0.0.*|0.1.*|0.2.*|0.3.*|0.4.0) release_tag="relay-v$VERSION" ;;
    0.4.*)
      # A patch bootstrap can also be dated; only legacy 0.4.x lacks an index.
      release_tag=$(curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
        "https://raw.githubusercontent.com/MrFlashAccount/homebrew-codewide/main/releases/relay/$VERSION" 2>/dev/null) \
        || release_tag="v$VERSION"
      ;;
    *)
      release_tag=$(curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
        "https://raw.githubusercontent.com/MrFlashAccount/homebrew-codewide/main/releases/relay/$VERSION")
      ;;
  esac
  printf '%s\n' "$release_tag" | grep -Eq '^(relay-v[0-9]+[.][0-9]+[.][0-9]+|v[0-9]+[.][0-9]+[.][0-9]+|release-[0-9]{4}-[0-9]{2}-[0-9]{2}[.][1-9][0-9]*)$' || {
    printf '%s\n' 'Invalid Relay release origin.' >&2; exit 2;
  }
  DOWNLOAD_BASE_URL="https://github.com/MrFlashAccount/CodeWide/releases/download/$release_tag"
fi
DOWNLOAD_BASE_URL=${DOWNLOAD_BASE_URL%/}

case "$DOWNLOAD_BASE_URL" in
  https://*) ;;
  http://*|file://*)
    if [ "$ALLOW_INSECURE_DOWNLOAD" != 1 ]; then
      printf '%s\n' 'Refusing a non-HTTPS download URL.' >&2
      exit 2
    fi
    ;;
  *)
    printf 'Unsupported download URL: %s\n' "$DOWNLOAD_BASE_URL" >&2
    exit 2
    ;;
esac

# Download and verify as the invoking user. Elevate only filesystem installation
# operations, so curl | sh works without running the downloaded script as root.
install_as_root=0
ancestor=$INSTALL_DIR
while [ ! -e "$ancestor" ]; do
  ancestor=$(dirname -- "$ancestor")
done
if [ ! -d "$ancestor" ] || [ ! -w "$ancestor" ] || [ ! -x "$ancestor" ]; then
  command -v sudo >/dev/null 2>&1 || {
    printf 'Installing to %s requires administrator access, but sudo is unavailable.\n' "$INSTALL_DIR" >&2
    exit 2
  }
  install_as_root=1
fi
install_command() {
  if [ "$install_as_root" = 1 ]; then
    sudo -- "$@"
  else
    "$@"
  fi
}

umask 077
temporary_root=$(mktemp -d "$TMP_ROOT/codewide-relay-install.XXXXXX")
staged=
unit_staged=
cleanup() {
  if [ -n "$staged" ]; then
    install_command rm -rf -- "$staged"
  fi
  if [ -n "$unit_staged" ]; then rm -f -- "$unit_staged"; fi
  case "$temporary_root" in
    "$TMP_ROOT"/codewide-relay-install.*) rm -rf -- "$temporary_root" ;;
    *) printf 'Refusing to remove unexpected directory: %s\n' "$temporary_root" >&2 ;;
  esac
}

replace_binary() {
  target_path=$1
  source_path=$2
  target_dir=$(dirname -- "$target_path")
  staged=$(install_command mktemp "$target_dir/.codewide-relay.install.XXXXXX") || return 1
  install_command cp "$source_path" "$staged" || return 1
  install_command chmod 0755 "$staged" || return 1
  install_command mv -f -- "$staged" "$target_path" || return 1
  staged=
}

# Points `link` at `target` with one rename, never leaving it absent.
switch_link() {
  link=$1
  link_target=$2
  link_staged="$(dirname -- "$link")/.$(basename -- "$link").next.$$"
  rm -f -- "$link_staged"
  ln -s "$link_target" "$link_staged" || return 1
  mv -fT -- "$link_staged" "$link" || { rm -f -- "$link_staged"; return 1; }
}

# Restores a path saved by save_entry: a symlink target, a file copy, or absence.
restore_entry() {
  entry=$1
  name=$2
  if [ -f "$temporary_root/$name.link" ]; then
    switch_link "$entry" "$(cat "$temporary_root/$name.link")"
  elif [ -f "$temporary_root/$name.file" ]; then
    replace_binary "$entry" "$temporary_root/$name.file"
  else
    rm -f -- "$entry"
  fi
}

save_entry() {
  entry=$1
  name=$2
  if [ -L "$entry" ]; then
    readlink "$entry" >"$temporary_root/$name.link"
  elif [ -f "$entry" ]; then
    cp -p "$entry" "$temporary_root/$name.file"
  fi
}

finish() {
  status=$?
  trap - EXIT HUP INT TERM
  if [ "$status" -ne 0 ] && [ "$deployment_started" = 1 ]; then
    printf '%s\n' 'Relay installation failed; restoring the previous deployment without changing its state.' >&2
    if [ "$activation_started" = 1 ]; then service_command stop || :; fi
    if [ "$managed" = 1 ]; then
      restore_entry "$install_root/current" current || printf '%s\n' 'Failed to restore the previous Relay generation.' >&2
      restore_entry "$guardian_path" guardian || printf '%s\n' 'Failed to restore the previous Relay update guardian.' >&2
      restore_entry "$INSTALL_DIR/codewide-relay" command || printf '%s\n' 'Failed to restore the previous Relay command.' >&2
      if [ "$update_unit_written" = 1 ]; then
        user_systemctl disable codewide-relay-update.service >/dev/null 2>&1 || :
        if [ -f "$temporary_root/previous-update.service" ]; then mv -f -- "$temporary_root/previous-update.service" "$update_service"; else rm -f -- "$update_service"; fi
      fi
    elif [ -f "$temporary_root/previous-binary" ]; then
      replace_binary "$INSTALL_DIR/codewide-relay" "$temporary_root/previous-binary" || printf '%s\n' 'Failed to restore the previous Relay executable.' >&2
    else
      install_command rm -f -- "$INSTALL_DIR/codewide-relay" || :
    fi
    if [ "$activation_started" = 1 ] && [ "$service_was_enabled" = 0 ]; then
      service_command disable || :
    fi
    if [ "$unit_created" = 1 ]; then rm -f -- "$unit_path"; fi
    if [ "$activation_started" = 1 ]; then
      if [ "$service_scope" = system ]; then privileged systemctl daemon-reload || :;
      else user_systemctl daemon-reload || :; fi
      if [ "$service_was_active" = 1 ]; then
        if service_command restart; then
          wait_service_ready || printf '%s\n' 'The previous Relay could not become ready after rollback.' >&2
        else
          printf '%s\n' 'Failed to restart the previous Relay service.' >&2
        fi
      fi
    fi
  fi
  cleanup
  exit "$status"
}
trap finish EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# systemd expands percent specifiers and dollar variables even in quoted paths.
unit_argument() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/%/%%/g; s/\$/$$/g'
}

write_unit() {
  mkdir -p -- "$unit_root"
  unit_staged=$(mktemp "$unit_root/.codewide-relay.unit.XXXXXX")
  # systemd rejects a dollar sign in its executable token. env immediately
  # execs the Relay, preserving both literal installation paths and MainPID.
  printf '%s\n' '[Unit]' 'Description=CodeWide Relay' '' '[Service]' \
    "ExecStart=\"$(unit_argument "$(command -v env)")\" -- \"$(unit_argument "$INSTALL_DIR/codewide-relay")\" serve --state \"$(unit_argument "$state_root")\"" \
    'Restart=on-failure' 'RestartSec=2' 'TimeoutStopSec=20' 'UMask=0077' \
    'NoNewPrivileges=yes' '' '[Install]' 'WantedBy=default.target' >"$unit_staged"
  chmod 0644 "$unit_staged"
  unit_created=1
  mv -- "$unit_staged" "$unit_path"
  unit_staged=
}

# The stable runner of remote updates. The running Relay starts it on apply;
# it is also wanted at login so an interrupted operation always resumes.
write_update_unit() {
  mkdir -p -- "$unit_root"
  update_service="$unit_root/codewide-relay-update.service"
  if [ -f "$update_service" ]; then cp -p "$update_service" "$temporary_root/previous-update.service"; fi
  service_staged=$(mktemp "$temporary_root/codewide-relay-update.service.XXXXXX")
  printf '%s\n' '[Unit]' 'Description=CodeWide Relay update guardian' 'After=network-online.target' 'Wants=network-online.target' '' '[Service]' 'Type=oneshot' 'UMask=0077' \
    "ExecStart=\"$(unit_argument "$(command -v env)")\" -- \"$(unit_argument "$guardian_path")\" update-run --install-root \"$(unit_argument "$install_root")\" --state \"$(unit_argument "$state_root")\"" \
    'Restart=on-failure' 'RestartSec=2s' 'TimeoutStartSec=15min' 'NoNewPrivileges=true' 'PrivateTmp=false' \
    'ProtectSystem=full' 'ProtectHome=read-only' \
    "ReadWritePaths=\"$(unit_argument "$install_root")\" \"$(unit_argument "$state_root/host-update")\"" \
    "ReadOnlyPaths=\"$(unit_argument "$install_root/bootstrap")\"" \
    'AmbientCapabilities=' '' '[Install]' 'WantedBy=default.target' >"$service_staged"
  chmod 0644 "$service_staged"
  update_unit_written=1
  mv -f -- "$service_staged" "$update_service"
}

start_service() {
  if [ "$service_scope" = user ]; then
    # A login session owns the user manager. Lingering is an optional host
    # policy, not an installation prerequisite, so rootless installs never
    # change it implicitly.
    attempt=0
    until user_systemctl show-environment >/dev/null 2>"$temporary_root/manager-error"; do
      attempt=$((attempt + 1))
      if [ "$attempt" -ge 10 ]; then
        printf '%s\n' 'The systemd user manager did not become available.' >&2
        sed -n '1,8p' "$temporary_root/manager-error" >&2
        return 1
      fi
      sleep 1
    done
    if [ "$service_existed" = 0 ] && \
      [ -n "$(user_systemctl show codewide-relay.service --property=FragmentPath --value)" ]; then
      # A pre-existing global user unit can become visible after the bus starts.
      service_existed=1
      if service_command is-active --quiet; then service_was_active=1; fi
      if service_command is-enabled --quiet; then service_was_enabled=1; fi
    fi
    if [ "$service_existed" = 0 ]; then write_unit; fi
    # The previous self-updater watched a pending marker; generations replace it.
    user_systemctl disable --now codewide-relay-update.path >/dev/null 2>&1 || :
    write_update_unit
    user_systemctl daemon-reload
  else
    privileged systemctl daemon-reload
  fi
  activation_started=1
  service_command enable
  if [ "$managed" = 1 ]; then user_systemctl enable codewide-relay-update.service; fi
  service_command restart
  wait_service_ready
}

wait_service_ready() {
  attempt=0
  while [ "$attempt" -lt 10 ]; do
    if service_command is-active --quiet && \
      timeout 2 "$INSTALL_DIR/codewide-relay" status --json >"$temporary_root/status" 2>"$temporary_root/status-error"; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
  printf '%s\n' 'Relay did not become ready through its administration socket.' >&2
  if [ -f "$temporary_root/status-error" ]; then sed -n '1,8p' "$temporary_root/status-error" >&2; fi
  return 1
}

download() {
  source_url=$1
  destination=$2
  if [ "$ALLOW_INSECURE_DOWNLOAD" = 1 ]; then
    curl --fail --silent --show-error --location --retry 3 \
      --output "$destination" "$source_url"
  else
    curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
      --location --retry 3 --output "$destination" "$source_url"
  fi
}

download_artifact="$temporary_root/$asset"
checksum="$temporary_root/$asset.sha256"
download "$DOWNLOAD_BASE_URL/$asset" "$download_artifact"
download "$DOWNLOAD_BASE_URL/$asset.sha256" "$checksum"

line_count=$(wc -l <"$checksum" | tr -d ' ')
expected=$(awk 'NR == 1 { print $1 }' "$checksum")
recorded_name=$(awk 'NR == 1 { print $2 }' "$checksum")
recorded_name=${recorded_name#\*}
case "$expected" in
  ????????????????????????????????????????????????????????????????) ;;
  *) printf '%s\n' 'Relay checksum has an invalid length.' >&2; exit 1 ;;
esac
case "$expected" in
  *[!0-9a-f]*) printf '%s\n' 'Relay checksum is malformed.' >&2; exit 1 ;;
esac
if [ "$line_count" != 1 ] || [ "$recorded_name" != "$asset" ]; then
  printf '%s\n' 'Relay checksum manifest is malformed.' >&2
  exit 1
fi

if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$download_artifact" | awk '{ print $1 }')
elif command -v shasum >/dev/null 2>&1; then
  actual=$(shasum -a 256 "$download_artifact" | awk '{ print $1 }')
else
  printf '%s\n' 'sha256sum or shasum is required to verify CodeWide Relay.' >&2
  exit 2
fi
if [ "$actual" != "$expected" ]; then
  printf '%s\n' 'CodeWide Relay checksum verification failed.' >&2
  exit 1
fi

if [ "$managed" = 1 ]; then
  # The bundle holds exactly one directory with one executable. Reject absolute
  # or parent paths, links and special files before extracting anything.
  listing=$(tar -tzf "$download_artifact") || { printf '%s\n' 'The Relay bundle is not a valid archive.' >&2; exit 1; }
  if printf '%s\n' "$listing" | grep -vxF \
    -e "$bundle_directory/" -e "$bundle_directory/bin/" -e "$bundle_directory/bin/codewide-relay" | grep -q .; then
    printf '%s\n' 'The Relay bundle contains an unexpected path.' >&2
    exit 1
  fi
  if tar -tvzf "$download_artifact" | cut -c1 | grep -qv '^[-d]$'; then
    printf '%s\n' 'The Relay bundle contains a link or special file.' >&2
    exit 1
  fi
  mkdir -p -- "$temporary_root/bundle"
  tar -xzf "$download_artifact" -C "$temporary_root/bundle"
  payload="$temporary_root/bundle/$bundle_directory/bin/codewide-relay"
  [ -f "$payload" ] && [ ! -L "$payload" ] || { printf '%s\n' 'The Relay bundle has no executable.' >&2; exit 1; }
else
  payload=$download_artifact
fi
chmod 0755 "$payload"
reported_version=$("$payload" --version)
if [ "$reported_version" != "codewide-relay $VERSION" ]; then
  printf 'Downloaded Relay version mismatch: %s\n' "$reported_version" >&2
  exit 1
fi
if [ "$managed" = 1 ]; then
  build_info=$("$payload" build-info)
  build=$(printf '%s\n' "$build_info" | sed -n 's/^{"schemaVersion":1,"version":"[0-9A-Za-z._-]*","build":"\([0-9a-f]\{12\}\)","sourceRevision":"[0-9a-f]\{40\}"}$/\1/p')
  source_revision=$(printf '%s\n' "$build_info" | sed -n 's/^{"schemaVersion":1,"version":"[0-9A-Za-z._-]*","build":"[0-9a-f]\{12\}","sourceRevision":"\([0-9a-f]\{40\}\)"}$/\1/p')
  if [ -z "$build" ] || [ "$(printf '%.12s' "$source_revision")" != "$build" ]; then
    printf '%s\n' 'The Relay bundle has invalid build provenance.' >&2
    exit 1
  fi
fi
if [ "$activate" = 1 ] && [ "$service_existed" = 1 ]; then
  if [ "$service_was_active" != 1 ]; then
    printf '%s\n' 'The existing Relay service must be running so its state directory can be verified safely.' >&2
    exit 1
  fi
  if [ "$service_scope" = system ]; then state_root=$(privileged "$payload" bootstrap-info);
  else state_root=$("$payload" bootstrap-info); fi
  case "$state_root" in
    /*) ;;
    *) printf '%s\n' 'The active Relay reported an invalid state directory.' >&2; exit 1 ;;
  esac
  if printf '%s' "$state_root" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    printf '%s\n' 'The active Relay reported an unsafe state directory.' >&2
    exit 1
  fi
  [ -d "$state_root" ] || {
    printf '%s\n' 'The active Relay state directory does not exist.' >&2
    exit 1
  }
fi
if [ "$activate" = 1 ] && [ "$service_existed" = 0 ] && \
  [ -S "$state_root/control.sock" ] && \
  timeout 5 "$payload" --state "$state_root" status --json >/dev/null 2>&1; then
  printf '%s\n' 'A manually managed Relay is already running. Refusing to start a second server. Nothing was installed. Use --no-start to update only its executable.' >&2
  exit 2
fi

if [ "$managed" = 1 ] && [ "$install_as_root" = 1 ]; then
  printf 'A rootless Relay service needs a writable command directory: %s\nChoose one with --install-dir. Nothing was installed.\n' "$INSTALL_DIR" >&2
  exit 2
fi
if [ "$install_as_root" = 1 ]; then
  printf 'Installing to %s (administrator access required).\n' "$INSTALL_DIR"
  sudo -v
fi
# Public executable directories must be traversable by the service owner too.
# Leave permissions of existing directories alone.
(umask 022; install_command mkdir -p -m 0755 "$INSTALL_DIR")
generation_digest=$expected
guardian_path="$install_root/bootstrap/codewide-relay-update-guardian"
if [ "$managed" = 1 ]; then
  save_entry "$install_root/current" current
  save_entry "$guardian_path" guardian
  save_entry "$INSTALL_DIR/codewide-relay" command
elif [ -f "$INSTALL_DIR/codewide-relay" ]; then
  install_command cp -p "$INSTALL_DIR/codewide-relay" "$temporary_root/previous-binary"
fi
deployment_started=1
if [ "$managed" = 1 ]; then
  mkdir -p -- "$install_root/generations" "$install_root/bootstrap" "$state_root/host-update"
  chmod 0700 "$install_root/bootstrap" "$state_root/host-update"
  generation="$install_root/generations/$generation_digest"
  metadata=$(printf '{"schemaVersion":1,"version":"%s","build":"%s","sourceRevision":"%s","artifactDigest":"%s"}' \
    "$VERSION" "$build" "$source_revision" "$generation_digest")
  if [ -e "$generation" ]; then
    # Reinstalling the same signed bundle reuses its immutable generation.
    if [ "$(cat "$generation/metadata.json" 2>/dev/null)" != "$metadata" ] || \
      ! cmp -s "$payload" "$generation/bin/codewide-relay"; then
      printf '%s\n' 'An invalid Relay generation already exists for this release.' >&2
      exit 1
    fi
  else
    staged=$(mktemp -d "$install_root/generations/.manual-XXXXXX")
    mkdir -p -- "$staged/bin"
    cp "$payload" "$staged/bin/codewide-relay"
    chmod 0755 "$staged/bin" "$staged/bin/codewide-relay"
    printf '%s\n' "$metadata" >"$staged/metadata.json"
    chmod 0600 "$staged/metadata.json"
    # Same modes as a generation the update runner publishes.
    chmod 0700 "$staged"
    mv -- "$staged" "$generation"
    staged=
  fi
  # The stable guardian is a copy of this release, outside every generation.
  guardian_staged="$install_root/bootstrap/.guardian-new.$$"
  cp "$payload" "$guardian_staged"
  chmod 0755 "$guardian_staged"
  mv -f -- "$guardian_staged" "$guardian_path"
  switch_link "$install_root/current" "generations/$generation_digest"
  switch_link "$INSTALL_DIR/codewide-relay" "$install_root/current/bin/codewide-relay"
else
  replace_binary "$INSTALL_DIR/codewide-relay" "$payload"
fi

hash -r 2>/dev/null || :
resolved=$(command -v codewide-relay || :)
if [ "$resolved" != "$INSTALL_DIR/codewide-relay" ] ||
  [ "$(codewide-relay --version)" != "codewide-relay $VERSION" ]; then
  printf 'Relay was copied, but command lookup verification failed: %s\n' "$resolved" >&2
  exit 1
fi
printf 'Installed codewide-relay %s to %s\n' "$VERSION" "$INSTALL_DIR/codewide-relay"
if [ "$activate" = 1 ]; then
  start_service
  if [ "$managed" = 1 ]; then
    # Retire the previous self-updater's executables, units and state.
    rm -f -- "$unit_root/codewide-relay-update.path"
    rm -rf -- "$state_root/update"
    user_systemctl daemon-reload || :
    # Keep the active and the previous generation for rollback.
    previous_generation=
    if [ -f "$temporary_root/current.link" ]; then previous_generation=$(cat "$temporary_root/current.link"); fi
    for candidate in "$install_root"/generations/*; do
      [ -d "$candidate" ] || continue
      case "generations/$(basename -- "$candidate")" in
        "generations/$generation_digest"|"$previous_generation") ;;
        *) rm -rf -- "$candidate" ;;
      esac
    done
  fi
  if [ "$service_scope" = system ]; then
    printf '%s\n' 'Relay is running and enabled as a system service.'
    printf '%s\n' 'This installer keeps an existing system service, which receives no remote updates. To move Relay to a rootless user service, run once:'
    printf '%s\n' '  curl -fsSL https://raw.githubusercontent.com/MrFlashAccount/CodeWide/main/install/relay-migrate-user | sh'
  else
    printf '%s\n' 'Relay is running and enabled for this user.'
    if [ "$(loginctl show-user "$(id -un)" --property=Linger --value 2>/dev/null || :)" != yes ]; then
      printf '%s\n' 'Relay starts after login. To also run before login and after logout, an administrator may enable systemd lingering for this user.'
    fi
  fi
  printf '%s\n' 'Ready: codewide-relay pair'
  printf '%s\n' 'Allow inbound TCP 8780 in your VPS firewall (or the existing service port if customized).'
else
  printf '%s\n' 'Service activation skipped. Executable ready: codewide-relay'
fi
deployment_started=0
