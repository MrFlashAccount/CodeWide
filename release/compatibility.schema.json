{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codewide.dev/release/compatibility.schema.json",
  "title": "CodeWide release compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "interfaces", "products", "links"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "interfaces": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["versions"],
        "properties": {
          "versions": { "$ref": "#/$defs/versions" },
          "contract": { "type": "string", "minLength": 1 }
        }
      }
    },
    "products": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provides", "requires"],
        "properties": {
          "provides": { "$ref": "#/$defs/interfaceVersions" },
          "requires": { "$ref": "#/$defs/interfaceVersions" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "consumer", "interface"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "consumer": { "type": "string", "minLength": 1 },
          "interface": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "interfaceVersions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/versions" }
    }
  }
}
