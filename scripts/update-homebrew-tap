#!/bin/sh
set -eu

usage() {
  printf 'Usage: %s <linux|macos|relay> <version> <sha256> <tap-root> [release-tag]\n' "$0" >&2
  exit 2
}

[ "$#" -eq 4 ] || [ "$#" -eq 5 ] || usage
product=$1
version=${2#v}
sha256=$3
tap_root=$4
release_tag=${5:-}

printf '%s\n' "$version" | grep -Eq '^[0-9]+[.][0-9]+[.][0-9]+([.-][0-9A-Za-z.-]+)?$' || usage
printf '%s\n' "$sha256" | grep -Eq '^[0-9a-f]{64}$' || usage
if [ -z "$release_tag" ]; then
  case "$product" in
    linux) release_tag="companion-linux-v$version" ;;
    macos) release_tag="v$version" ;;
    relay) release_tag="relay-v$version" ;;
    *) usage ;;
  esac
fi
printf '%s\n' "$release_tag" | grep -Eq '^[a-z-]*v[0-9]+[.][0-9]+[.][0-9]+$' || usage
mkdir -p "$tap_root/Formula" "$tap_root/Casks"

case "$product" in
  linux)
    formula="$tap_root/Formula/codewide.rb"
    mkdir -p "$tap_root/versions"
    sed \
      -e "s/@VERSION@/$version/g" \
      -e "s/@SHA256@/$sha256/g" \
      -e "s/@RELEASE_TAG@/$release_tag/g" \
      "$(dirname -- "$0")/../packaging/homebrew/codewide-linux.rb.in" >"$formula"
    printf '{"codewide-companion":"codewide"}\n' >"$tap_root/formula_renames.json"
    rm -f -- "$tap_root/Formula/codewide-companion.rb"
    printf '%s\n' "$version" >"$tap_root/versions/companion-linux"
    ;;
  macos)
    cask="$tap_root/Casks/codewide.rb"
    sed \
      -e "s/@VERSION@/$version/g" \
      -e "s/@SHA256@/$sha256/g" \
      "$(dirname -- "$0")/../packaging/homebrew/codewide.rb.in" >"$cask"
    ;;
  relay)
    formula="$tap_root/Formula/relay.rb"
    sed \
      -e "s/@VERSION@/$version/g" \
      -e "s/@SHA256@/$sha256/g" \
      -e "s/@RELEASE_TAG@/$release_tag/g" \
      "$(dirname -- "$0")/../packaging/homebrew/relay.rb.in" >"$formula"
    ;;
  *) usage ;;
esac
