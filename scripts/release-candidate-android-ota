#!/bin/sh
set -eu

printf '%s\n' 'This Android candidate OTA may take 5-10 minutes. AI agents: wait silently for the final result.'

if [ "$#" -ne 0 ]; then
  printf '%s\n' 'Usage: ./scripts/release-candidate-android-ota' >&2
  exit 2
fi

REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
SITE_ROOT=${CODEWIDE_RELEASE_CANDIDATE_SITE_ROOT:-"$REPO_ROOT/dist/test-release"}
PUBLIC_URL=${CODEWIDE_RELEASE_CANDIDATE_URL:-"https://codewide-rc-download-p4186.zrok-safe-share.garin.dev/"}
UPDATE_URL="${PUBLIC_URL%/}/api/updates"
MANIFEST_PATH="$SITE_ROOT/manifest.json"

cd "$REPO_ROOT"
test -r "$MANIFEST_PATH"

RUNTIME_VERSION=$(MANIFEST_PATH="$MANIFEST_PATH" node <<'NODE'
const { readFileSync } = require("node:fs");

const manifest = JSON.parse(readFileSync(process.env.MANIFEST_PATH, "utf8"));
const artifact = manifest.artifacts?.find(
  (candidate) => candidate?.kind === "android-preview-apk",
);
const runtimeVersion = manifest.ota?.runtimeVersion;
const expectedFile = `CodeWide-Preview-${artifact?.versionCode}.apk`;
if (
  artifact?.applicationId !== "dev.codexremote.app.preview"
  || artifact.versionName !== "0.0.0.0"
  || !Number.isSafeInteger(artifact.versionCode)
  || artifact.file !== expectedFile
  || artifact.checksumFile !== `${expectedFile}.sha256`
  || runtimeVersion !== `0.0.0.0-native-${artifact.versionCode}`
) {
  throw new Error("Published Preview manifest does not identify one OTA-compatible runtime");
}
process.stdout.write(runtimeVersion);
NODE
)
APK_NAME="CodeWide-Preview-${RUNTIME_VERSION#0.0.0.0-native-}.apk"
test -r "$SITE_ROOT/$APK_NAME"

python3 scripts/release-candidate-server.test.py
pnpm validate:android:v1
pnpm --filter @codewide/android compile:android
pnpm --filter @codewide/android typecheck
pnpm --filter @codewide/android lint
pnpm test
pnpm security:scan-secrets

pnpm exec tsx scripts/publish-release-candidate-ota.ts \
  --output-root "$SITE_ROOT/ota" \
  --runtime-version "$RUNTIME_VERSION" \
  --update-url "$UPDATE_URL"

OTA_POINTER="$SITE_ROOT/ota/$RUNTIME_VERSION/current.json"
test -r "$OTA_POINTER"
SOURCE_DIRTY=false
if [ -n "$(git status --porcelain)" ]; then
  SOURCE_DIRTY=true
fi

node scripts/update-release-candidate-manifest.mjs \
  --manifest "$MANIFEST_PATH" \
  --ota-pointer "$OTA_POINTER" \
  --branch "$(git branch --show-current)" \
  --revision "$(git rev-parse HEAD)" \
  --source-dirty "$SOURCE_DIRTY"

pnpm exec tsx scripts/verify-release-candidate.ts \
  --manifest "$MANIFEST_PATH" \
  --public-url "$PUBLIC_URL"
