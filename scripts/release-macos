#!/bin/sh
set -eu

REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
VERSION=
BASE=
DRY_RUN=false
FORCE=false

usage() {
  printf 'Usage: %s <version> [--base <git-ref>] [--dry-run] [--force]\n' "$0" >&2
  exit 2
}

[ "$#" -ge 1 ] || usage
VERSION=${1#v}
shift
printf '%s\n' "$VERSION" | grep -Eq '^[0-9]+[.][0-9]+[.][0-9]+([.-][0-9A-Za-z.-]+)?$' || usage

while [ "$#" -gt 0 ]; do
  case "$1" in
    --base)
      [ "$#" -ge 2 ] || usage
      BASE=$2
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --force)
      FORCE=true
      shift
      ;;
    *) usage ;;
  esac
done

cd "$REPO_ROOT"
[ -z "$(git status --porcelain)" ] || {
  printf '%s\n' 'release-macos: the worktree must be clean' >&2
  exit 1
}
BRANCH=$(git branch --show-current)
[ -n "$BRANCH" ] || { printf '%s\n' 'release-macos: detached HEAD is not releasable' >&2; exit 1; }
LOCAL_REVISION=$(git rev-parse HEAD)
REMOTE_REVISION=$(git ls-remote origin "refs/heads/$BRANCH" | cut -f1)
[ "$LOCAL_REVISION" = "$REMOTE_REVISION" ] || {
  printf '%s\n' 'release-macos: the current commit must be pushed to the current branch' >&2
  exit 1
}

REQUEST_ID="local-$(date -u +%Y%m%dT%H%M%SZ)-$$"
set -- workflow run macos-release.yml --ref "$BRANCH" \
  -f "version=$VERSION" \
  -f "dry_run=$DRY_RUN" \
  -f "force=$FORCE" \
  -f "request_id=$REQUEST_ID"
if [ -n "$BASE" ]; then
  set -- "$@" -f "base=$BASE"
fi
gh "$@"

RUN_ID=
attempt=0
while [ -z "$RUN_ID" ] && [ "$attempt" -lt 24 ]; do
  RUN_ID=$(gh run list \
    --workflow macos-release.yml \
    --branch "$BRANCH" \
    --event workflow_dispatch \
    --limit 30 \
    --json databaseId,displayTitle \
    --jq ".[] | select(.displayTitle | contains(\"$REQUEST_ID\")) | .databaseId" | head -n 1)
  [ -n "$RUN_ID" ] || sleep 5
  attempt=$((attempt + 1))
done
[ -n "$RUN_ID" ] || { printf '%s\n' 'release-macos: dispatched run was not found' >&2; exit 1; }

gh run watch "$RUN_ID" --exit-status
RUN_URL=$(gh run view "$RUN_ID" --json url --jq .url)
if [ "$DRY_RUN" = true ]; then
  printf '%s\n' "{\"release\":\"macos\",\"status\":\"validated\",\"dryRun\":true,\"version\":\"$VERSION\",\"sourceRevision\":\"$LOCAL_REVISION\",\"runUrl\":\"$RUN_URL\"}"
else
  RELEASE_URL=$(gh release view "v$VERSION" --json url --jq .url)
  printf '%s\n' "{\"release\":\"macos\",\"status\":\"published\",\"version\":\"$VERSION\",\"sourceRevision\":\"$LOCAL_REVISION\",\"runUrl\":\"$RUN_URL\",\"releaseUrl\":\"$RELEASE_URL\"}"
fi
