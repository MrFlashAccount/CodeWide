{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "agent-index",
  "projectType": "library",
  "sourceRoot": "crates/agent-index/src",
  "tags": ["language:rust", "type:library"],
  "metadata": {
    "description": "Shared offset index of append-only agent transcripts"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "rustWorkspace"]
  },
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p agent-index --all-targets --all-features -- -D warnings",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test -p agent-index --all-features",
        "cwd": "."
      }
    }
  }
}
