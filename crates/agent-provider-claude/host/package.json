{
  "name": "@codewide/claude-agent-host",
  "version": "0.1.0",
  "private": true,
  "description": "Claude agent host: serves codewide-agent v1 over the Claude Agent SDK as a child process of the CodeWide companion",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/checkInstallLock.mjs && vitest run --root ../../.. crates/agent-provider-claude/host",
    "lint": "oxlint --config oxlint.config.mjs --tsconfig tsconfig.json --type-aware --type-check --deny-warnings --report-unused-disable-directives src scripts",
    "format": "oxfmt --config oxfmt.json --write .",
    "format:check": "oxfmt --config oxfmt.json --check ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "@anthropic-ai/sdk": "0.127.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codewide/agent-protocol": "workspace:*",
    "@sergeigarin/hygene": "github:MrFlashAccount/hygiene#828e4a23b913b010ac314964b32aa903870fa621",
    "@types/node": "^24.0.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "engines": {
    "node": ">=22"
  }
}
