{
  "protocolVersion": 1,
  "threadReadModelVersion": 3,
  "globalSupervisorLimitsV1": {
    "version": 1,
    "liveChannelMaxEnvelopes": 256,
    "liveChannelMaxBytes": 4194304,
    "liveEnvelopeMaxBytes": 262144,
    "microphoneInputBufferMaxDurationMs": 2000,
    "microphoneInputBufferMaxBytes": 262144,
    "outputPlaybackBufferMaxDurationMs": 5000,
    "outputPlaybackBufferMaxBytes": 524288,
    "dynamicToolInputMaxBytes": 65536,
    "dynamicToolOutputMaxBytes": 262144,
    "listChatsPageMaxEntries": 100,
    "readChatPageMaxItems": 100,
    "readChatPageMaxBytes": 262144,
    "eventCoalescingMaxDistinctSources": 32,
    "eventCoalescingWindowMs": 2000,
    "realtimeStartupTimeoutMs": 15000,
    "interruptionAckTimeoutMs": 2000,
    "realtimeStopCloseTimeoutMs": 5000
  },
  "threadProjectionPatch": {
    "field": "codewideThreadPatch",
    "version": 1,
    "operations": [
      { "method": "thread/status/changed", "kind": "threadStatus" },
      { "method": "thread/name/updated", "kind": "threadName" },
      { "method": "thread/deleted", "kind": "threadDeleted" },
      { "method": "thread/settings/updated", "kind": "threadSettings" },
      { "method": "thread/started", "kind": "threadStarted" },
      { "method": "thread/archived", "kind": "threadArchived", "archived": true },
      { "method": "thread/unarchived", "kind": "threadArchived", "archived": false },
      { "method": "turn/started", "kind": "turnStarted" },
      { "method": "turn/completed", "kind": "turnCompleted" },
      { "method": "model/rerouted", "kind": "modelRerouted" },
      { "method": "item/started", "kind": "itemUpsert" },
      { "method": "item/completed", "kind": "itemUpsert" },
      { "method": "item/agentMessage/delta", "kind": "itemTextDelta", "itemType": "agentMessage" },
      { "method": "item/plan/delta", "kind": "itemTextDelta", "itemType": "plan" },
      { "method": "item/commandExecution/outputDelta", "kind": "itemTextDelta", "itemType": "commandExecution" },
      { "method": "item/fileChange/patchUpdated", "kind": "fileChanges" },
      { "method": "item/mcpToolCall/progress", "kind": "mcpProgress" },
      { "method": "thread/tokenUsage/updated", "kind": "tokenUsage" },
      { "method": "turn/diff/updated", "kind": "turnDiff" },
      { "method": "turn/plan/updated", "kind": "turnPlan" },
      { "method": "item/reasoning/summaryPartAdded", "kind": "reasoningPart", "field": "summary" },
      { "method": "item/reasoning/summaryTextDelta", "kind": "reasoningDelta", "field": "summary" },
      { "method": "item/reasoning/textDelta", "kind": "reasoningDelta", "field": "content" }
    ]
  },
  "webSocketPaths": [
    "/v1/app-server",
    "/v1/sync"
  ],
  "httpRoutes": [
    "GET /healthz",
    "POST /v1/pairing/claim",
    "POST /v1/pairing/start",
    "POST /v1/sessions/challenge",
    "POST /v1/sessions",
    "GET /v1/devices",
    "DELETE /v1/devices/{deviceId}",
    "DELETE /v1/device",
    "GET /v1/files/download",
    "HEAD /v1/files/download",
    "HEAD /v1/files/upload",
    "PUT /v1/files/upload",
    "DELETE /v1/files/upload",
    "GET /v1/files/preview",
    "POST /v1/media/materialize",
    "GET /v1/media/{id}",
    "GET /v1/content/{digest}",
    "GET /v1/port-forwards/discovery",
    "POST /v1/tunnels",
    "POST /v1/telemetry/events",
    "GET /v1/telemetry/events"
  ],
  "publicBuildShelfPaths": [
    "/",
    "/api/builds",
    "/api/updates",
    "/api/updates/assets/*",
    "/latest.apk",
    "/CodeWide.apk",
    "/download/*"
  ],
  "rpcPolicy": {
    "methodFilter": "none",
    "unknownMethodHandling": "forwardToAppServer",
    "passiveMode": "noRpc"
  }
}
