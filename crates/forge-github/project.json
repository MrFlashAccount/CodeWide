{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "forge-github",
  "projectType": "library",
  "sourceRoot": "crates/forge-github/src",
  "tags": ["language:rust", "type:library"],
  "metadata": {
    "description": "Built-in GitHub forge plugin"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "rustWorkspace"]
  },
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p forge-github --all-targets --all-features -- -D warnings",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test -p forge-github --all-features",
        "cwd": "."
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build -p forge-github --release",
        "cwd": "."
      }
    }
  }
}
