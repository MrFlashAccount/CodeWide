{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "companion-swift-ffi",
  "projectType": "library",
  "sourceRoot": "crates/companion-swift-ffi/src",
  "tags": ["language:rust", "type:ffi", "platform:macos"],
  "implicitDependencies": ["companion-core"],
  "metadata": {
    "description": "Narrow UniFFI and static-library adapter for Swift"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "rustWorkspace"]
  },
  "targets": {
    "build-macos-arm64": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/apps/companion-macos/scripts/build-rust-ffi.sh",
        "{workspaceRoot}/apps/companion-macos/Sources/CompanionSwiftFFI/**/*",
        "{workspaceRoot}/apps/companion-macos/Sources/CompanionSwiftFFIFFI/**/*",
        { "env": "CODEWIDE_CORE_VERSION" },
        { "env": "CODEWIDE_HOST_UPDATE_SIGNING_KEY_ID" },
        { "env": "CODEWIDE_HOST_UPDATE_SIGNING_PUBLIC_KEY_SPKI" },
        { "env": "MACOSX_DEPLOYMENT_TARGET" },
        { "runtime": "rustc -vV" },
        { "runtime": "xcrun --show-sdk-version" }
      ],
      "outputs": ["{options.outputPath}"],
      "options": {
        "command": "apps/companion-macos/scripts/build-rust-ffi.sh {args.outputPath}",
        "outputPath": "apps/companion-macos/.build/rust/release",
        "cwd": ".",
        "forwardAllArgs": false
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p companion-swift-ffi --all-targets --all-features -- -D warnings",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test -p companion-swift-ffi --all-features",
        "cwd": "."
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build -p companion-swift-ffi --release",
        "cwd": "."
      }
    }
  }
}
