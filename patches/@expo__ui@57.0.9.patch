+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.MenuDefaults
+import androidx.compose.material3.Surface
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.MutableState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.Shape
+import androidx.compose.ui.graphics.TransformOrigin
+import androidx.compose.ui.graphics.graphicsLayer
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.unit.Density
+import androidx.compose.ui.unit.IntOffset
+import androidx.compose.ui.unit.IntRect
+import androidx.compose.ui.unit.IntSize
+import androidx.compose.ui.unit.LayoutDirection
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.window.Popup
+import androidx.compose.ui.window.PopupPositionProvider
+import androidx.compose.ui.window.PopupProperties
+import kotlin.math.max
+import kotlin.math.min
+
+// Material's own menu metrics (androidx.compose.material3 Menu.kt), which it keeps internal.
+private val MenuVerticalMargin = 48.dp
+private val MenuHorizontalMargin = 8.dp
+private val MenuVerticalPadding = 8.dp
+private const val ExpandedScale = 1f
+private const val ClosedScale = 0.8f
+private const val ExpandedAlpha = 1f
+private const val ClosedAlpha = 0f
+
+/**
+ * A dropdown menu lined up with its anchor by [alignment]: Material's
+ * `DropdownMenu` only opens at the anchor's start and takes no position
+ * provider, so this one hosts the same surface and motion in a [Popup] whose
+ * [PopupPositionProvider] places it from the anchor and menu bounds of the
+ * layout pass itself.
+ */
+@Composable
+internal fun AnchoredMenuPopup(
+  expanded: Boolean,
+  onDismissRequest: () -> Unit,
+  alignment: MenuHorizontalAlignment,
+  gap: Float,
+  shape: Shape,
+  containerColor: Color,
+  content: @Composable ColumnScope.() -> Unit
+) {
+  val expandedState = remember { MutableTransitionState(false) }
+  expandedState.targetState = expanded
+  if (!expandedState.currentState && !expandedState.targetState) {
+    return
+  }
+  val density = LocalDensity.current
+  val transformOrigin = remember { mutableStateOf(TransformOrigin.Center) }
+  val positionProvider = remember(alignment, gap, density) {
+    AlignedMenuPositionProvider(alignment, gap, density) { anchor, menu ->
+      transformOrigin.value = menuTransformOrigin(anchor, menu)
+    }
+  }
+  Popup(
+    onDismissRequest = onDismissRequest,
+    popupPositionProvider = positionProvider,
+    properties = PopupProperties(focusable = true)
+  ) {
+    AnchoredMenuSurface(expandedState, transformOrigin, shape, containerColor, content)
+  }
+}
+
+@Composable
+private fun AnchoredMenuSurface(
+  expandedState: MutableTransitionState<Boolean>,
+  transformOrigin: MutableState<TransformOrigin>,
+  shape: Shape,
+  containerColor: Color,
+  content: @Composable ColumnScope.() -> Unit
+) {
+  val transition = rememberTransition(expandedState, "AnchoredMenu")
+  val motion = MaterialTheme.motionScheme
+  val scale by transition.animateFloat(transitionSpec = { motion.fastSpatialSpec() }) { open ->
+    if (open) ExpandedScale else ClosedScale
+  }
+  val alpha by transition.animateFloat(transitionSpec = { motion.fastEffectsSpec() }) { open ->
+    if (open) ExpandedAlpha else ClosedAlpha
+  }
+  Surface(
+    modifier = Modifier.graphicsLayer {
+      scaleX = scale
+      scaleY = scale
+      this.alpha = alpha
+      this.transformOrigin = transformOrigin.value
+    },
+    shape = shape,
+    color = containerColor,
+    tonalElevation = MenuDefaults.TonalElevation,
+    shadowElevation = MenuDefaults.ShadowElevation
+  ) {
+    Column(
+      modifier = Modifier
+        .padding(vertical = MenuVerticalPadding)
+        .width(IntrinsicSize.Max)
+        .verticalScroll(rememberScrollState()),
+      content = content
+    )
+  }
+}
+
+/**
+ * Lines the menu up with the anchor's start, centre or end and keeps it inside
+ * the window's horizontal margins; opens it [gap] below the anchor, or above
+ * it when it does not fit below, as Material's menu does.
+ */
+internal class AlignedMenuPositionProvider(
+  private val alignment: MenuHorizontalAlignment,
+  gap: Float,
+  density: Density,
+  private val onPositionCalculated: (anchor: IntRect, menu: IntRect) -> Unit
+) : PopupPositionProvider {
+  private val gapPx = with(density) { gap.dp.roundToPx() }
+  private val horizontalMarginPx = with(density) { MenuHorizontalMargin.roundToPx() }
+  private val verticalMarginPx = with(density) { MenuVerticalMargin.roundToPx() }
+
+  override fun calculatePosition(
+    anchorBounds: IntRect,
+    windowSize: IntSize,
+    layoutDirection: LayoutDirection,
+    popupContentSize: IntSize
+  ): IntOffset {
+    val x = alignedX(anchorBounds, windowSize.width, layoutDirection, popupContentSize.width)
+    val y = verticalY(anchorBounds, windowSize.height, popupContentSize.height)
+    onPositionCalculated(
+      anchorBounds,
+      IntRect(x, y, x + popupContentSize.width, y + popupContentSize.height)
+    )
+    return IntOffset(x, y)
+  }
+
+  private fun alignedX(
+    anchor: IntRect,
+    windowWidth: Int,
+    layoutDirection: LayoutDirection,
+    menuWidth: Int
+  ): Int {
+    val leading = layoutDirection == LayoutDirection.Ltr
+    val preferred = when (alignment) {
+      MenuHorizontalAlignment.START -> if (leading) anchor.left else anchor.right - menuWidth
+      MenuHorizontalAlignment.CENTER -> anchor.left + (anchor.width - menuWidth) / 2
+      MenuHorizontalAlignment.END -> if (leading) anchor.right - menuWidth else anchor.left
+    }
+    val maxX = windowWidth - horizontalMarginPx - menuWidth
+    // A menu wider than the window's usable width starts at its margin.
+    return if (maxX < horizontalMarginPx) horizontalMarginPx else preferred.coerceIn(horizontalMarginPx, maxX)
+  }
+
+  private fun verticalY(anchor: IntRect, windowHeight: Int, menuHeight: Int): Int {
+    val below = anchor.bottom + gapPx
+    if (below + menuHeight <= windowHeight - verticalMarginPx) {
+      return below
+    }
+    val above = anchor.top - gapPx - menuHeight
+    if (above >= verticalMarginPx) {
+      return above
+    }
+    // Neither side fits: the side with more room, kept inside the margins.
+    val maxY = max(verticalMarginPx, windowHeight - verticalMarginPx - menuHeight)
+    return (if (anchor.center.y < windowHeight / 2) below else above).coerceIn(verticalMarginPx, maxY)
+  }
+}
+
+/** The menu grows from where it meets its anchor, as Material's menu does. */
+private fun menuTransformOrigin(anchor: IntRect, menu: IntRect): TransformOrigin {
+  val pivotX = when {
+    menu.left >= anchor.right -> 0f
+    menu.right <= anchor.left -> 1f
+    menu.width == 0 -> 0f
+    else -> {
+      val center = (max(anchor.left, menu.left) + min(anchor.right, menu.right)) / 2
+      (center - menu.left).toFloat() / menu.width
+    }
+  }
+  val pivotY = when {
+    menu.top >= anchor.bottom -> 0f
+    menu.bottom <= anchor.top -> 1f
+    menu.height == 0 -> 0f
+    else -> {
+      val center = (max(anchor.top, menu.top) + min(anchor.bottom, menu.bottom)) / 2
+      (center - menu.top).toFloat() / menu.height
+    }
+  }
+  return TransformOrigin(pivotX, pivotY)
+}
