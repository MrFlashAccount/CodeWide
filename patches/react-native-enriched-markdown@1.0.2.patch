+package com.swmansion.enriched.markdown.input.editing
+
+import com.swmansion.enriched.markdown.input.model.StyleType
+
+data class CodeReplacement(val start: Int, val end: Int, val payload: String, val type: StyleType, val language: String?)
+
+/** Only completed delimiters convert; unfinished Markdown remains ordinary editable text. */
+object CodeInputShortcut {
+  private val block = Regex("(?m)^(`{3,})([^`\\n]*)\\n([\\s\\S]*?)\\n\\1$")
+  private val inline = Regex("(?<![`\\\\])(`+)([^`\\n]+)\\1(?!`)")
+
+  fun find(text: String, cursor: Int): CodeReplacement? {
+    if (cursor <= 0 || cursor > text.length) return null
+    val before = text.substring(0, cursor)
+    if (text[cursor - 1] == '\n') {
+      val start = before.lastIndexOf('\n', cursor - 2) + 1
+      val opening = Regex("`{3,}([^`\\n]*)\\n").matchEntire(before.substring(start)) ?: return null
+      return CodeReplacement(start, cursor, "", StyleType.CODE_BLOCK, opening.groupValues[1].trim())
+    }
+    if (text[cursor - 1] != '`') return null
+    val fenced = block.findAll(before).firstOrNull { it.range.last + 1 == cursor }
+    if (fenced != null) return CodeReplacement(fenced.range.first, cursor, fenced.groupValues[3], StyleType.CODE_BLOCK, fenced.groupValues[2].trim())
+    val lineStart = before.lastIndexOf('\n') + 1
+    // Do not treat backticks within an unfinished fenced block as inline Markdown.
+    if (Regex("(?m)^`{3,}").findAll(before).count() % 2 != 0) return null
+    val match = inline.findAll(before.substring(lineStart)).firstOrNull { it.range.last + 1 == cursor - lineStart } ?: return null
+    return CodeReplacement(lineStart + match.range.first, cursor, match.groupValues[2], StyleType.INLINE_CODE, null)
+  }
+}
