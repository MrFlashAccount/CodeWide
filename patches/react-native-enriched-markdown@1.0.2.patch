+
+/**
+ * Keyboard clipboard panels bypass the context menu and can commit source-app
+ * appearance spans. Only characters are imported; Markdown owns appearance.
+ * Composing text and its IME metadata still pass through unchanged.
+ */
+class MatchStyleInputConnection(target: InputConnection) : AndroidInputConnectionWrapper(target, false) {
+  override fun commitText(text: CharSequence, newCursorPosition: Int): Boolean =
