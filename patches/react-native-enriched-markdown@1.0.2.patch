+
+/** Draws code chrome without replacing the EditText, its caret or IME ownership. */
+class InputCodeBlockDecoration(private val view: EnrichedMarkdownTextInputView) {
+  private val density = view.resources.displayMetrics.density
+  private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+  private var copying: FormattingRange? = null
+  private val touchSlop = ViewConfiguration.get(view.context).scaledTouchSlop
+  private data class EdgeCaret(val code: FormattingRange, val before: Boolean)
+  private var edgeCaret: EdgeCaret? = null
+  private var downX = 0f
+  private var downY = 0f
+
+  /** Let EditText own focus, IME, drags and long presses; adjust only a short edge tap. */
+  fun placeCaretAfterTouch(event: MotionEvent) {
+    when (event.actionMasked) {
+      MotionEvent.ACTION_DOWN -> {
+        downX = event.x
+        downY = event.y
+        edgeCaret = caretAtEdge(event)
+      }
+      MotionEvent.ACTION_MOVE -> {
+        if (kotlin.math.abs(event.x - downX) > touchSlop || kotlin.math.abs(event.y - downY) > touchSlop) edgeCaret = null
+      }
+      MotionEvent.ACTION_UP -> {
+        val target = edgeCaret
+        edgeCaret = null
+        if (target != null && event.eventTime - event.downTime < ViewConfiguration.getLongPressTimeout() &&
+          kotlin.math.abs(event.x - downX) <= touchSlop && kotlin.math.abs(event.y - downY) <= touchSlop) {
+          view.placeCaretOutsideCodeBlock(target.code, target.before)
+        }
+      }
+      MotionEvent.ACTION_CANCEL, MotionEvent.ACTION_POINTER_DOWN -> edgeCaret = null
+    }
+  }
+
+  private fun caretAtEdge(event: MotionEvent): EdgeCaret? {
+    val textLength = view.text?.length ?: return null
+    val x = event.x - view.totalPaddingLeft + view.scrollX
+    val y = event.y - view.totalPaddingTop + view.scrollY
+    for (range in view.formattingStore.allRanges) {
+      if (range.type != StyleType.CODE_BLOCK) continue
+      val box = bounds(range) ?: continue
+      if (x < box.left || x > box.right) continue
+      if (y < box.top + 26 * density && (y >= box.top || range.start == 0)) return EdgeCaret(range, before = true)
+      if (y >= box.bottom - 8 * density && (y <= box.bottom || range.end == textLength)) return EdgeCaret(range, before = false)
+    }
+    return null
+  }
+
+  private fun bounds(range: FormattingRange): RectF? {
+    val layout = view.layout ?: return null
+    val length = view.text?.length ?: return null
+    if (range.start >= length || range.end > length) return null
+    val first = layout.getLineForOffset(range.start)
+    val last = layout.getLineForOffset((range.end - 1).coerceAtLeast(range.start))
+    return RectF(0f, layout.getLineTop(first).toFloat(),
+      (view.width - view.totalPaddingLeft - view.totalPaddingRight).toFloat(), layout.getLineBottom(last).toFloat())
+  }
+
+  fun draw(canvas: Canvas) {
+    canvas.save()
