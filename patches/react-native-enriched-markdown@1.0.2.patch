+package com.swmansion.enriched.markdown.input.formatting
+
+import com.swmansion.enriched.markdown.input.model.BlockRange
+import com.swmansion.enriched.markdown.input.model.FormattingRange
+import com.swmansion.enriched.markdown.input.model.StyleType
+import com.swmansion.enriched.markdown.input.model.isCode
+
+/** Code is literal: neither link detection nor other inline delimiters may rewrite its payload. */
+object CodeMarkdown {
+  fun serialize(
+    text: String,
+    ranges: List<FormattingRange>,
+    blocks: List<BlockRange>,
+    prefix: (BlockRange) -> String,
+  ): String {
+    val result = StringBuilder()
+    var position = 0
+    for (code in ranges.filter { it.type.isCode }.sortedBy { it.start }) {
+      if (code.start < position || code.end > text.length || code.start > code.end) continue
+      appendNormal(result, text, position, code.start, ranges, blocks, prefix)
+      val payload = text.substring(code.start, code.end)
+      val fenceSize = maxOf(if (code.type == StyleType.CODE_BLOCK) 3 else 1, longestBackticks(payload) + 1)
+      val fence = "`".repeat(fenceSize)
+      if (code.type == StyleType.CODE_BLOCK) {
+        if (result.isNotEmpty() && result.last() != '\n') result.append('\n')
+        // A fence info string cannot contain backticks or line breaks.
+        val language = code.codeLanguage.orEmpty().takeWhile { it != '`' && it != '\n' && it != '\r' }
+        result.append(fence).append(language).append('\n').append(payload).append('\n').append(fence)
+        if (code.end < text.length && text[code.end] != '\n') result.append('\n')
+      } else {
+        val pad = payload.startsWith('`') || payload.endsWith('`') ||
+          (payload.startsWith(' ') && payload.endsWith(' ') && payload.any { it != ' ' })
+        result.append(fence)
+        if (pad) result.append(' ')
+        result.append(payload)
+        if (pad) result.append(' ')
+        result.append(fence)
+      }
+      position = code.end
+    }
+    appendNormal(result, text, position, text.length, ranges, blocks, prefix)
+    // Empty editable blocks use the same internal anchor as empty list items.
+    // Keep it out of both serializer entrypoints, including the inline overload.
+    return MarkdownSerializer.stripZwsp(result.toString())
+  }
+
+  private fun appendNormal(
+    output: StringBuilder, text: String, start: Int, end: Int,
+    ranges: List<FormattingRange>, blocks: List<BlockRange>, prefix: (BlockRange) -> String,
+  ) {
+    if (start == end) return
+    val inline = ranges.filter { !it.type.isCode && it.start < end && it.end > start }
+      .map { it.relocated(maxOf(it.start, start) - start, minOf(it.end, end) - start) }
+    // A prefix belongs to its original line start, not to each chunk after inline code.
+    val paragraphs = blocks.filter { it.start >= start && it.start < end }
+      .map { BlockRange(it.type, it.start - start, minOf(it.end, end) - start, it.level) }
+    output.append(MarkdownSerializer.serialize(text.substring(start, end), inline, paragraphs, prefix))
+  }
+
+  private fun longestBackticks(text: String): Int {
+    var longest = 0
+    var run = 0
+    for (char in text) {
+      run = if (char == '`') run + 1 else 0
+      longest = maxOf(longest, run)
+    }
+    return longest
+  }
+}
