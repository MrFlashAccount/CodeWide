+    // subtracting scroll again makes the decoration move faster than the glyphs.
+    canvas.translate(view.totalPaddingLeft.toFloat(), view.totalPaddingTop.toFloat())
+    for (range in view.formattingStore.allRanges) {
+      if (range.type != StyleType.CODE_BLOCK) continue
+      val box = bounds(range) ?: continue
