+
+  @RequiresApi(34)
+  override fun replaceText(
+    start: Int,
+    end: Int,
+    text: CharSequence,
+    newCursorPosition: Int,
+    textAttribute: TextAttribute?,
+  ): Boolean = super.replaceText(start, end, text.toString(), newCursorPosition, textAttribute)
+}
