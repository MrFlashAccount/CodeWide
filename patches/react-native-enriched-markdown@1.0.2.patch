+import com.swmansion.enriched.markdown.input.spans.InputCodeBlockSpan
+
+private class CodeTypefaceSpan : TypefaceSpan("monospace"), MarkdownSpan
+private class CodeBackgroundSpan : BackgroundColorSpan(0x22888888), MarkdownSpan
+
+class CodeStyleHandler(override val styleType: StyleType, private val density: Float = 1f) : StyleHandler {
+  override val mergingConfig = StyleMergingConfig()
+  override fun createSpans(range: FormattingRange, style: InputFormatterStyle): List<CharacterStyle> =
+    if (styleType == StyleType.CODE_BLOCK) listOf(CodeTypefaceSpan(), InputCodeBlockSpan(density))
+    else listOf(CodeTypefaceSpan(), CodeBackgroundSpan())
+  override fun spanClasses(): List<Class<out CharacterStyle>> =
+    if (styleType == StyleType.CODE_BLOCK) listOf(CodeTypefaceSpan::class.java, InputCodeBlockSpan::class.java)
+    else listOf(CodeTypefaceSpan::class.java, CodeBackgroundSpan::class.java)
+}
