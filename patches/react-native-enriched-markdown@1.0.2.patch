+package com.swmansion.enriched.markdown.input.editing
+
+import com.swmansion.enriched.markdown.input.formatting.FormattingStore
+import com.swmansion.enriched.markdown.input.model.FormattingRange
+
+/** Removing an entity binding never deletes its label; Android owns character/grapheme edits. */
+object EditableMentions {
+  fun detachForEdit(store: FormattingStore, start: Int, deleted: Int): FormattingRange? {
+    val affected = store.allRanges.filter {
+      it.mentionIndicator != null &&
+        if (deleted == 0) start > it.start && start < it.end else start < it.end && start + deleted > it.start
+    }
+    for (range in affected) store.removeRange(range)
+    return affected.firstOrNull()
+  }
+}
