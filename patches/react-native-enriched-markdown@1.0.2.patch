@@ -0,0 +1,37 @@
+package com.swmansion.enriched.markdown.input.editing
+
+import com.swmansion.enriched.markdown.input.model.FormattingRange
+import com.swmansion.enriched.markdown.input.model.StyleType
+
+/** Content offsets exclude the real paragraphs used to enter/leave a code block. */
+data class EditableCodeContent(val text: String, val start: Int, val end: Int) {
+  companion object {
+    fun isEmptyBlock(text: CharSequence, range: FormattingRange): Boolean =
+      range.type == StyleType.CODE_BLOCK && (range.start until range.end).all { text[it] == ZWSP }
+
+    fun exitsOnEnter(range: FormattingRange, context: EditContext, text: CharSequence): Boolean =
+      range.type == StyleType.INLINE_CODE && context.deletedLength == 0 && context.insertedLength == 1 &&
+        range.end == context.editStart && text.getOrNull(context.editStart) == '\n'
+
+    /** A trailing empty code line needs a character for Android's exclusive spans. */
+    fun needsTailAnchor(text: CharSequence, range: FormattingRange): Boolean =
+      range.type == StyleType.CODE_BLOCK &&
+        (range.start == range.end || text.getOrNull(range.end - 1) == '\n')
+
+    fun caretBefore(text: CharSequence, range: FormattingRange): Int? =
+      (range.start - 1).takeIf { it >= 0 && text.getOrNull(it) == '\n' }
+
+    fun caretAfter(text: CharSequence, range: FormattingRange): Int? =
+      (range.end + 1).takeIf { text.getOrNull(range.end) == '\n' }
+
+    fun block(value: String): EditableCodeContent {
+      val content = value.ifEmpty { ZWSP.toString() }
+      return EditableCodeContent("\n$content\n", 1, 1 + content.length)
+    }
+
+    fun inline(value: String): EditableCodeContent {
+      val content = value.ifEmpty { "code" }
+      return EditableCodeContent("$content ", 0, content.length)
+    }
+  }
+}
