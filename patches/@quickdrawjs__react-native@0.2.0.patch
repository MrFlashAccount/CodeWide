+// Quickdraw intentionally keeps its records open-ended. CodeWide uses that
+// extension point for image-review backgrounds: they render and export like
+// normal image shapes, but every editor interaction treats them as immutable.
+const installLockedShapeSupport = (editor) => {
+  const isLocked = (record) => record?.typeName === 'shape' && record.props?.locked === true
+  const setSelection = editor.setSelection.bind(editor)
+  editor.setSelection = (ids) => setSelection(ids.filter((id) => !isLocked(editor.store.get(id))))
+
+  const hitTest = editor.hitTest.bind(editor)
+  editor.hitTest = (...args) => {
+    const hit = hitTest(...args)
+    return isLocked(hit) ? null : hit
+  }
+
+  editor.clearBoard = () => {
+    const lockedShapes = editor.store.shapes().filter(isLocked)
+    const lockedAssetIds = new Set(lockedShapes.flatMap((shape) =>
+      shape.type === 'image' && shape.props.assetId ? [shape.props.assetId] : []
+    ))
+    editor.store.remove(editor.store.all().flatMap((record) => {
+      if (record.typeName === 'asset') return lockedAssetIds.has(record.id) ? [] : [record.id]
+      return isLocked(record) ? [] : [record.id]
+    }))
+    editor.setSelection([])
+  }
+}
