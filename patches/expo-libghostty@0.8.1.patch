+
+bool decodePng(void*, const GhosttyAllocator* allocator, const uint8_t* data, size_t dataLen,
+               GhosttySysImage* out) {
+  if (data == nullptr || dataLen == 0 || out == nullptr) return false;
+
+  AImageDecoder* decoder = nullptr;
+  int result = AImageDecoder_createFromBuffer(data, dataLen, &decoder);
+  if (result != ANDROID_IMAGE_DECODER_SUCCESS || decoder == nullptr) {
+    logImageDecoderError("AImageDecoder_createFromBuffer", result);
+    return false;
+  }
+
+  const auto cleanup = [&]() { AImageDecoder_delete(decoder); };
+  const AImageDecoderHeaderInfo* header = AImageDecoder_getHeaderInfo(decoder);
+  if (header == nullptr) {
+    cleanup();
+    return false;
+  }
+  const int32_t width = AImageDecoderHeaderInfo_getWidth(header);
+  const int32_t height = AImageDecoderHeaderInfo_getHeight(header);
+  if (width <= 0 || height <= 0) {
+    cleanup();
+    return false;
+  }
+
+  const uint64_t pixelLen64 = static_cast<uint64_t>(width) * static_cast<uint64_t>(height) * 4ULL;
+  if (pixelLen64 == 0 || pixelLen64 > kKittyImageStorageLimit ||
+      pixelLen64 > std::numeric_limits<size_t>::max()) {
+    cleanup();
+    return false;
+  }
+
+  result = AImageDecoder_setAndroidBitmapFormat(decoder, ANDROID_BITMAP_FORMAT_RGBA_8888);
+  if (result != ANDROID_IMAGE_DECODER_SUCCESS) {
+    logImageDecoderError("AImageDecoder_setAndroidBitmapFormat", result);
+    cleanup();
+    return false;
+  }
+  result = AImageDecoder_setUnpremultipliedRequired(decoder, true);
+  if (result != ANDROID_IMAGE_DECODER_SUCCESS) {
+    logImageDecoderError("AImageDecoder_setUnpremultipliedRequired", result);
+    cleanup();
+    return false;
+  }
+
+  const size_t stride = AImageDecoder_getMinimumStride(decoder);
+  const size_t expectedStride = static_cast<size_t>(width) * 4;
+  if (stride != expectedStride) {
+    cleanup();
+    return false;
+  }
+
+  const size_t pixelLen = static_cast<size_t>(pixelLen64);
+  uint8_t* pixels = ghostty_alloc(allocator, pixelLen);
+  if (pixels == nullptr) {
+    cleanup();
+    return false;
+  }
+  result = AImageDecoder_decodeImage(decoder, pixels, stride, pixelLen);
+  cleanup();
+  if (result != ANDROID_IMAGE_DECODER_SUCCESS) {
+    logImageDecoderError("AImageDecoder_decodeImage", result);
+    ghostty_free(allocator, pixels, pixelLen);
+    return false;
+  }
+
+  out->width = static_cast<uint32_t>(width);
+  out->height = static_cast<uint32_t>(height);
+  out->data = pixels;
+  out->data_len = pixelLen;
+  return true;
+}
+
+void installGhosttySystemCallbacks() {
+  ghostty_sys_set(GHOSTTY_SYS_OPT_DECODE_PNG, reinterpret_cast<const void*>(decodePng));
+}
