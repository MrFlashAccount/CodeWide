diff --git a/android/src/main/java/expo/modules/libghostty/PersistentTerminalRegistry.kt b/android/src/main/java/expo/modules/libghostty/PersistentTerminalRegistry.kt
new file mode 100644
index 0000000000000000000000000000000000000000..b9904bb0006f2dc5bfc2fe679db781c0455377da
--- /dev/null
+++ b/android/src/main/java/expo/modules/libghostty/PersistentTerminalRegistry.kt
@@ -0,0 +1,48 @@
+package expo.modules.libghostty
+
+/**
+ * Keeps only logical VT sessions alive while their React view is temporarily
+ * unmounted. Views, geometry and bitmap caches are always recreated from the
+ * session's current snapshot.
+ *
+ * All calls happen on the Android main thread through Expo view props or the
+ * module function registered with runOnQueue(.main).
+ */
+internal object PersistentTerminalRegistry {
+  private data class Entry(
+    val session: GhosttyTerminalSession,
+    var attached: Boolean,
+  )
+
+  private val entries = LinkedHashMap<String, Entry>()
+
+  fun acquire(id: String): GhosttyTerminalSession {
+    require(id.isNotBlank() && id.length <= MAX_ID_CHARS) { "Persistent terminal id is invalid" }
+    val existing = entries[id]
+    if (existing == null) {
+      check(entries.size < MAX_RETAINED_TERMINALS) { "Too many persistent terminals are retained" }
+      return GhosttyTerminalSession().also { session ->
+        entries[id] = Entry(session, attached = true)
+      }
+    }
+    check(!existing.attached) { "Persistent terminal is already attached" }
+    existing.attached = true
+    return existing.session
+  }
+
+  fun detach(id: String, session: GhosttyTerminalSession) {
+    val entry = entries[id]
+    if (entry == null || entry.session !== session) {
+      session.destroy()
+      return
+    }
+    entry.attached = false
+  }
+
+  fun release(id: String) {
+    entries.remove(id)?.session?.destroy()
+  }
+
+  private const val MAX_ID_CHARS = 128
+  private const val MAX_RETAINED_TERMINALS = 8
+}
