+void logImageDecoderError(const char* operation, int result) {
+  const char* detail = AImageDecoder_resultToString(result);
+  __android_log_print(ANDROID_LOG_WARN, kLogTag, "%s failed: %s (%d)", operation,
+                      detail == nullptr ? "unknown error" : detail, result);
