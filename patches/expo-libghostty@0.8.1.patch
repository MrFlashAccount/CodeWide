+package expo.modules.libghostty
+
+/**
+ * Logical libghostty state whose lifetime is independent from an Android View.
+ *
+ * The native handle owns the parsed VT grid, cursor, alternate screen,
+ * scrollback and terminal modes. Pixel buffers and layout geometry belong to
+ * [GhosttyTerminalView] and are deliberately not retained with this session.
+ */
+internal class GhosttyTerminalSession {
+  var handle: Long = GhosttyVt.nativeCreate(INITIAL_COLS, INITIAL_ROWS, MAX_SCROLLBACK)
+    private set
+
+  var finished: Boolean = false
+
+  var fontSizeDp: Float = 14f
+
+  var theme: GhosttyTerminalTheme = GhosttyTerminalTheme()
+
+  fun destroy() {
+    if (handle == 0L) return
+    GhosttyVt.nativeFree(handle)
+    handle = 0L
+  }
+
+  private companion object {
+    const val INITIAL_COLS = 80
+    const val INITIAL_ROWS = 24
+    const val MAX_SCROLLBACK = 10_000L
+  }
+}
+
+internal data class GhosttyTerminalTheme(
+  val foreground: String? = null,
+  val background: String? = null,
+  val cursorColor: String? = null,
+  val selectionBackground: String? = null,
+  val selectionForeground: String? = null,
+  val palette: Array<String?>? = null,
+)
