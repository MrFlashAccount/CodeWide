+// Fixed-width placement records returned to Kotlin:
+// image id, placement id, image generation, image width, image height, image format,
+// rendered width, rendered height, viewport column, viewport row,
+// source x, source y, source width, source height, x offset, y offset, z-index.
+JNIEXPORT jlongArray JNICALL
+Java_expo_modules_libghostty_GhosttyVt_nativeKittyPlacements(
+    JNIEnv* env, jobject, jlong handle) {
+  auto* session = fromHandle(handle);
+  if (session == nullptr) return nullptr;
+
+  GhosttyKittyGraphics graphics = nullptr;
+  if (ghostty_terminal_get(session->term, GHOSTTY_TERMINAL_DATA_KITTY_GRAPHICS, &graphics) !=
+          GHOSTTY_SUCCESS ||
+      graphics == nullptr || session->kittyIterator == nullptr) {
+    return env->NewLongArray(0);
+  }
+  if (ghostty_kitty_graphics_get(graphics, GHOSTTY_KITTY_GRAPHICS_DATA_PLACEMENT_ITERATOR,
+                                 &session->kittyIterator) != GHOSTTY_SUCCESS) {
+    return env->NewLongArray(0);
+  }
+
+  std::vector<jlong> records;
+  records.reserve(kKittyPlacementFields * 8);
+  while (ghostty_kitty_graphics_placement_next(session->kittyIterator)) {
+    uint32_t imageId = 0;
+    uint32_t placementId = 0;
+    uint32_t xOffset = 0;
+    uint32_t yOffset = 0;
+    int32_t z = 0;
+    if (ghostty_kitty_graphics_placement_get(
+            session->kittyIterator, GHOSTTY_KITTY_GRAPHICS_PLACEMENT_DATA_IMAGE_ID,
+            &imageId) != GHOSTTY_SUCCESS ||
+        ghostty_kitty_graphics_placement_get(
+            session->kittyIterator, GHOSTTY_KITTY_GRAPHICS_PLACEMENT_DATA_PLACEMENT_ID,
+            &placementId) != GHOSTTY_SUCCESS ||
+        ghostty_kitty_graphics_placement_get(
+            session->kittyIterator, GHOSTTY_KITTY_GRAPHICS_PLACEMENT_DATA_X_OFFSET,
+            &xOffset) != GHOSTTY_SUCCESS ||
+        ghostty_kitty_graphics_placement_get(
+            session->kittyIterator, GHOSTTY_KITTY_GRAPHICS_PLACEMENT_DATA_Y_OFFSET,
+            &yOffset) != GHOSTTY_SUCCESS ||
+        ghostty_kitty_graphics_placement_get(
+            session->kittyIterator, GHOSTTY_KITTY_GRAPHICS_PLACEMENT_DATA_Z, &z) !=
+            GHOSTTY_SUCCESS) {
+      continue;
+    }
+
+    GhosttyKittyGraphicsImage image = ghostty_kitty_graphics_image(graphics, imageId);
+    if (image == nullptr) continue;
+    uint32_t imageWidth = 0;
+    uint32_t imageHeight = 0;
+    GhosttyKittyImageFormat imageFormat = GHOSTTY_KITTY_IMAGE_FORMAT_RGBA;
+    uint64_t imageGeneration = 0;
+    if (ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_WIDTH,
+                                         &imageWidth) != GHOSTTY_SUCCESS ||
+        ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_HEIGHT,
+                                         &imageHeight) != GHOSTTY_SUCCESS ||
+        ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_FORMAT,
+                                         &imageFormat) != GHOSTTY_SUCCESS ||
+        ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_GENERATION,
+                                         &imageGeneration) != GHOSTTY_SUCCESS) {
+      continue;
+    }
+
+    GhosttyKittyGraphicsPlacementRenderInfo info{};
+    info.size = sizeof(info);
+    if (ghostty_kitty_graphics_placement_render_info(session->kittyIterator, image,
+                                                     session->term, &info) != GHOSTTY_SUCCESS ||
+        !info.viewport_visible) {
+      continue;
+    }
+
+    records.insert(records.end(), {
+        static_cast<jlong>(imageId),
+        static_cast<jlong>(placementId),
+        static_cast<jlong>(imageGeneration),
+        static_cast<jlong>(imageWidth),
+        static_cast<jlong>(imageHeight),
+        static_cast<jlong>(imageFormat),
+        static_cast<jlong>(info.pixel_width),
+        static_cast<jlong>(info.pixel_height),
+        static_cast<jlong>(info.viewport_col),
+        static_cast<jlong>(info.viewport_row),
+        static_cast<jlong>(info.source_x),
+        static_cast<jlong>(info.source_y),
+        static_cast<jlong>(info.source_width),
+        static_cast<jlong>(info.source_height),
+        static_cast<jlong>(xOffset),
+        static_cast<jlong>(yOffset),
+        static_cast<jlong>(z),
+    });
+  }
+
+  if (records.size() > static_cast<size_t>(std::numeric_limits<jsize>::max())) return nullptr;
+  jlongArray out = env->NewLongArray(static_cast<jsize>(records.size()));
+  if (out == nullptr || records.empty()) return out;
+  env->SetLongArrayRegion(out, 0, static_cast<jsize>(records.size()), records.data());
+  return out;
+}
+
+JNIEXPORT jboolean JNICALL
+Java_expo_modules_libghostty_GhosttyVt_nativeCopyKittyImage(
+    JNIEnv* env, jobject, jlong handle, jlong imageId, jlong expectedGeneration,
+    jobject bitmap) {
+  auto* session = fromHandle(handle);
+  if (session == nullptr || bitmap == nullptr || imageId < 0) return JNI_FALSE;
+
+  GhosttyKittyGraphics graphics = nullptr;
+  if (ghostty_terminal_get(session->term, GHOSTTY_TERMINAL_DATA_KITTY_GRAPHICS, &graphics) !=
+          GHOSTTY_SUCCESS ||
+      graphics == nullptr) {
+    return JNI_FALSE;
+  }
+  GhosttyKittyGraphicsImage image =
+      ghostty_kitty_graphics_image(graphics, static_cast<uint32_t>(imageId));
+  if (image == nullptr) return JNI_FALSE;
+
+  uint32_t width = 0;
+  uint32_t height = 0;
+  GhosttyKittyImageFormat format = GHOSTTY_KITTY_IMAGE_FORMAT_RGBA;
+  uint64_t generation = 0;
+  const uint8_t* source = nullptr;
+  size_t sourceLen = 0;
+  if (ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_WIDTH, &width) !=
+          GHOSTTY_SUCCESS ||
+      ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_HEIGHT, &height) !=
+          GHOSTTY_SUCCESS ||
+      ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_FORMAT, &format) !=
+          GHOSTTY_SUCCESS ||
+      ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_GENERATION,
+                                       &generation) != GHOSTTY_SUCCESS ||
+      ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_DATA_PTR, &source) !=
+          GHOSTTY_SUCCESS ||
+      ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_DATA_LEN, &sourceLen) !=
+          GHOSTTY_SUCCESS ||
+      source == nullptr || generation != static_cast<uint64_t>(expectedGeneration)) {
+    return JNI_FALSE;
+  }
+
+  const size_t sourceBpp = kittyBytesPerPixel(format);
+  if (sourceBpp == 0 || width == 0 || height == 0 ||
+      static_cast<uint64_t>(width) * height * sourceBpp != sourceLen) {
+    return JNI_FALSE;
+  }
+
+  AndroidBitmapInfo bitmapInfo{};
+  if (AndroidBitmap_getInfo(env, bitmap, &bitmapInfo) != ANDROID_BITMAP_RESULT_SUCCESS ||
+      bitmapInfo.format != ANDROID_BITMAP_FORMAT_RGBA_8888 || bitmapInfo.width != width ||
+      bitmapInfo.height != height || bitmapInfo.stride < static_cast<uint64_t>(width) * 4) {
+    return JNI_FALSE;
+  }
+
+  void* pixels = nullptr;
+  if (AndroidBitmap_lockPixels(env, bitmap, &pixels) != ANDROID_BITMAP_RESULT_SUCCESS ||
+      pixels == nullptr) {
+    return JNI_FALSE;
+  }
+
+  auto* destination = static_cast<uint8_t*>(pixels);
+  for (uint32_t y = 0; y < height; y++) {
+    const uint8_t* src = source + static_cast<size_t>(y) * width * sourceBpp;
+    uint8_t* dst = destination + static_cast<size_t>(y) * bitmapInfo.stride;
+    for (uint32_t x = 0; x < width; x++) {
+      uint8_t red = 0;
+      uint8_t green = 0;
+      uint8_t blue = 0;
+      uint8_t alpha = 255;
+      switch (format) {
+        case GHOSTTY_KITTY_IMAGE_FORMAT_RGB:
+          red = src[0]; green = src[1]; blue = src[2]; src += 3;
+          break;
+        case GHOSTTY_KITTY_IMAGE_FORMAT_RGBA:
+          red = src[0]; green = src[1]; blue = src[2]; alpha = src[3]; src += 4;
+          break;
+        case GHOSTTY_KITTY_IMAGE_FORMAT_GRAY_ALPHA:
+          red = green = blue = src[0]; alpha = src[1]; src += 2;
+          break;
+        case GHOSTTY_KITTY_IMAGE_FORMAT_GRAY:
+          red = green = blue = src[0]; src += 1;
+          break;
+        default:
+          AndroidBitmap_unlockPixels(env, bitmap);
+          return JNI_FALSE;
+      }
+      dst[0] = premultiply(red, alpha);
+      dst[1] = premultiply(green, alpha);
+      dst[2] = premultiply(blue, alpha);
+      dst[3] = alpha;
+      dst += 4;
+    }
+  }
+  AndroidBitmap_unlockPixels(env, bitmap);
+  return JNI_TRUE;
+}
