+size_t kittyBytesPerPixel(GhosttyKittyImageFormat format) {
+  switch (format) {
+    case GHOSTTY_KITTY_IMAGE_FORMAT_RGB: return 3;
+    case GHOSTTY_KITTY_IMAGE_FORMAT_RGBA: return 4;
+    case GHOSTTY_KITTY_IMAGE_FORMAT_GRAY_ALPHA: return 2;
+    case GHOSTTY_KITTY_IMAGE_FORMAT_GRAY: return 1;
+    default: return 0;
+  }
+}
