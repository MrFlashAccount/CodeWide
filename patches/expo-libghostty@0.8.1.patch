+JNIEXPORT jbyteArray JNICALL
+Java_expo_modules_libghostty_GhosttyVt_nativeEncodeMouseTap(
+    JNIEnv* env, jobject, jlong handle, jfloat x, jfloat y, jint metaState) {
+  auto* session = fromHandle(handle);
+  if (session == nullptr) return nullptr;
+
+  bool tracking = false;
+  if (ghostty_terminal_get(session->term, GHOSTTY_TERMINAL_DATA_MOUSE_TRACKING, &tracking) !=
+          GHOSTTY_SUCCESS ||
+      !tracking) {
+    return nullptr;
+  }
+
+  ghostty_mouse_encoder_setopt_from_terminal(session->mouseEncoder, session->term);
+  ghostty_mouse_encoder_reset(session->mouseEncoder);
+  ghostty_mouse_event_set_button(session->mouseEvent, GHOSTTY_MOUSE_BUTTON_LEFT);
+  ghostty_mouse_event_set_mods(session->mouseEvent, mapMods(metaState));
+  ghostty_mouse_event_set_position(session->mouseEvent, GhosttyMousePosition{x, y});
+
+  std::vector<uint8_t> encoded;
+  encoded.reserve(64);
+  const auto appendAction = [&](GhosttyMouseAction action, bool anyButtonPressed) -> bool {
+    ghostty_mouse_encoder_setopt(
+        session->mouseEncoder, GHOSTTY_MOUSE_ENCODER_OPT_ANY_BUTTON_PRESSED, &anyButtonPressed);
+    ghostty_mouse_event_set_action(session->mouseEvent, action);
+    char stackBuf[64];
+    size_t written = 0;
+    GhosttyResult result = ghostty_mouse_encoder_encode(
+        session->mouseEncoder, session->mouseEvent, stackBuf, sizeof(stackBuf), &written);
+    std::vector<char> heapBuf;
+    const char* bytes = stackBuf;
+    if (result == GHOSTTY_OUT_OF_SPACE) {
+      heapBuf.resize(written);
+      result = ghostty_mouse_encoder_encode(
+          session->mouseEncoder, session->mouseEvent, heapBuf.data(), heapBuf.size(), &written);
+      bytes = heapBuf.data();
+    }
+    if (result != GHOSTTY_SUCCESS) return false;
+    encoded.insert(encoded.end(), bytes, bytes + written);
+    return true;
+  };
+
+  if (!appendAction(GHOSTTY_MOUSE_ACTION_PRESS, false) ||
+      !appendAction(GHOSTTY_MOUSE_ACTION_RELEASE, true)) {
+    const bool released = false;
+    ghostty_mouse_encoder_setopt(
+        session->mouseEncoder, GHOSTTY_MOUSE_ENCODER_OPT_ANY_BUTTON_PRESSED, &released);
+    return nullptr;
+  }
+  const bool released = false;
+  ghostty_mouse_encoder_setopt(
+      session->mouseEncoder, GHOSTTY_MOUSE_ENCODER_OPT_ANY_BUTTON_PRESSED, &released);
+  if (encoded.empty()) return nullptr;
+
+  jbyteArray out = env->NewByteArray(static_cast<jsize>(encoded.size()));
+  if (out == nullptr) return nullptr;
+  env->SetByteArrayRegion(out, 0, static_cast<jsize>(encoded.size()),
+                          reinterpret_cast<const jbyte*>(encoded.data()));
+  return out;
+}
+
 }  // extern "C"
