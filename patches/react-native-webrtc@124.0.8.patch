+    /** Native consumers observe a peer without replacing its existing JS observer. */
+    public interface NativePeerListener {
+        void onEvent(String eventName, ReadableMap params);
+    }
+
+    private final java.util.concurrent.ConcurrentHashMap<Integer, NativePeerListener> nativePeerListeners =
+            new java.util.concurrent.ConcurrentHashMap<>();
+
+    public void addNativePeerListener(int id, NativePeerListener listener) {
+        if (nativePeerListeners.putIfAbsent(id, listener) != null) {
+            throw new IllegalStateException("Native peer listener already registered");
+        }
+    }
+
+    public void removeNativePeerListener(int id, NativePeerListener listener) {
+        nativePeerListeners.remove(id, listener);
+    }
+
+    /** Uses the same executor and peer as JS getStats; no second media session. */
+    public void getNativePeerStats(int id, org.webrtc.RTCStatsCollectorCallback callback) {
+        ThreadUtils.runOnExecutor(() -> {
+            PeerConnection peer = getPeerConnection(id);
+            if (peer == null) {
+                callback.onStatsDelivered(new org.webrtc.RTCStatsReport(0, java.util.Collections.emptyMap()));
+            } else {
+                peer.getStats(callback);
+            }
+        });
+    }
+
